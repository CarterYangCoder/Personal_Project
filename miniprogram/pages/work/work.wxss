.record-content { margin-top: -38rpx; }
.month-card { padding: 24rpx 28rpx 30rpx; }
.month-top { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.month-select { padding: 12rpx 22rpx; border: 1px solid #e2ddd4; border-radius: 999rpx; font-size: 29rpx; font-weight: 700; }
.month-note { color: #3c6876; font-size: 24rpx; }
.month-body { display: flex; flex-direction: row; align-items: center; margin-top: 24rpx; }
.month-progress { flex: 1; min-width: 0; padding-right: 22rpx; }
.month-count { display: flex; flex-direction: row; align-items: baseline; font-size: 26rpx; font-weight: 600; }
.count-strong { margin: 0 12rpx; font-size: 54rpx; font-weight: 700; }
.line-track { height: 20rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background-color: #e5e7e4; }
.line-track view { height: 100%; border-radius: 999rpx; background-image: linear-gradient(90deg, #08777d 0%, #1c9893 100%); }
.count-note { margin-top: 12rpx; color: #67808c; font-size: 20rpx; }
.ring-wrap { display: flex; flex-direction: row; align-items: center; }
.ring { display: flex; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; border-radius: 50%; background-image: conic-gradient(#08777d 0deg, #1c9893 241deg, #cce5df 241deg, #cce5df 360deg); }
.ring-hole { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border-radius: 50%; background-color: #fffdf8; }
.ring-hole text:first-child { font-size: 29rpx; font-weight: 700; }
.ring-hole text:last-child { margin-top: 2rpx; font-size: 18rpx; }
.focus-hours { display: flex; flex-direction: column; align-items: center; margin-left: 22rpx; padding-left: 22rpx; border-left: 1px solid #dedbd4; }
.focus-hours text:first-child { font-size: 42rpx; font-weight: 700; }
.focus-hours text:last-child { margin-top: 8rpx; color: #557481; font-size: 20rpx; }
.date-band { display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 74rpx; margin-top: 18rpx; padding: 0 24rpx; }
.date-main { font-size: 26rpx; font-weight: 700; }
.date-count { color: #506f7c; font-size: 21rpx; }
.timeline-list { margin-top: 18rpx; }
.timeline-row { display: flex; flex-direction: row; align-items: stretch; }
.time-col { position: relative; width: 104rpx; padding-top: 31rpx; }
.time-col > text { font-size: 23rpx; }
.time-dot { position: absolute; z-index: 2; top: 37rpx; right: 8rpx; width: 22rpx; height: 22rpx; border: 4rpx solid #eaf2ef; border-radius: 50%; background-color: #15978f; }
.time-dot.doing { background-color: #f0a23a; }
.time-dot.pending { background-color: #a8bdc7; }
.time-line { position: absolute; top: 50rpx; right: 17rpx; bottom: -12rpx; width: 1px; background-color: #ccd4d3; }
.task-card { flex: 1; min-width: 0; margin-bottom: 16rpx; padding: 24rpx 24rpx 20rpx; }
.task-head { display: flex; flex-direction: row; align-items: center; }
.task-title { flex: 1; min-width: 0; font-family: "Songti SC", serif; font-size: 28rpx; font-weight: 700; }
.category-chip { align-self: flex-start; margin-top: 10rpx; padding: 7rpx 13rpx; border-radius: 999rpx; color: #db5c48; font-size: 18rpx; background-color: #fde8e2; }
.task-details { display: block; margin-top: 12rpx; color: #66808c; font-size: 21rpx; line-height: 1.55; }
.task-actions { display: flex; flex-direction: row; justify-content: flex-end; margin-top: 10rpx; color: #5c7884; font-size: 19rpx; }
.task-actions text { margin-left: 22rpx; }
.handbook-card { display: flex; flex-direction: row; align-items: center; margin: 6rpx 0 18rpx; padding: 18rpx; overflow: hidden; }
.handbook-card > image { width: 190rpx; height: 112rpx; border-radius: 18rpx; }
.handbook-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 20rpx; }
.handbook-title { font-family: "Songti SC", serif; font-size: 24rpx; font-weight: 700; }
.handbook-note { margin-top: 8rpx; color: #66808c; font-size: 19rpx; }
.handbook-arrow { margin-left: 12rpx; color: #285b69; font-size: 21rpx; }
