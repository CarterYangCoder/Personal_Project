<view class="assistant-page">
  <scroll-view class="assistant-scroll" type="list" scroll-y scroll-with-animation scroll-into-view="{{scrollTarget}}">
    <view>
      <summer-header title="小夏 AI 助手" subtitle="陪你记录、思考、成长\n让这个夏天更有意义" back="{{true}}" />
      <view class="assistant-content">
        <view class="hello-row">
          <view class="assistant-avatar"><image src="/assets/icons/spark-teal.png" mode="aspectFit" /></view>
          <view class="hello-copy"><text class="hello-title">{{greeting}}，{{displayName}}</text><text class="hello-note">已读取你的记考摘要</text></view>
        </view>
        <view class="summary-card paper-surface">
          <view class="summary-item coral"><image src="/assets/icons/briefcase-coral.png" mode="aspectFit" /><text class="summary-num">{{summary.work}}</text><text>工作</text></view>
          <view class="summary-item blue"><image src="/assets/icons/book-blue.png" mode="aspectFit" /><text class="summary-num">{{summary.study}}</text><text>学习</text></view>
          <view class="summary-item gold"><image src="/assets/icons/heart-gold.png" mode="aspectFit" /><text class="summary-num">{{summary.volunteer}}</text><text>公益</text></view>
          <view class="summary-item green"><image src="/assets/icons/leaf-green.png" mode="aspectFit" /><text class="summary-num">{{summary.diary}}</text><text>生活</text></view>
        </view>
        <view wx:if="{{messages.length <= 1}}" class="quick-grid">
          <button wx:for="{{quickPrompts}}" wx:key="text" class="quick-card {{item.tone}}" bindtap="usePrompt" data-text="{{item.text}}" disabled="{{thinking}}">
            <text class="quick-icon">{{item.icon}}</text><text class="quick-label">{{item.label}}</text><text class="quick-note">{{item.note}}</text><text class="quick-arrow">›</text>
          </button>
        </view>
        <view class="messages">
          <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="message-row {{item.role}}">
            <view wx:if="{{item.role === 'assistant'}}" class="message-avatar"><image src="/assets/icons/spark-teal.png" mode="aspectFit" /></view>
            <view class="message-stack"><text class="message-bubble">{{item.content}}</text><button wx:if="{{item.action}}" class="message-action" bindtap="openAction" data-page="{{item.action.page}}"><text>{{item.action.label}}　›</text></button></view>
            <image wx:if="{{item.role === 'user'}}" class="user-avatar" src="/assets/images/avatar-xiaoxia.png" mode="aspectFill" />
          </view>
          <view wx:if="{{thinking}}" id="thinking" class="message-row assistant"><view class="message-avatar"><image src="/assets/icons/spark-teal.png" mode="aspectFit" /></view><view class="thinking"><text>正在想一想…</text></view></view>
          <view id="chat-end" class="chat-end"></view>
        </view>
      </view>
    </view>
  </scroll-view>
  <view class="composer-wrap">
    <view class="composer paper-surface"><text class="composer-icon">◌</text><textarea class="composer-input" value="{{draft}}" bindinput="updateDraft" placeholder="和小夏聊聊今天…" auto-height maxlength="200" confirm-type="send" bindconfirm="sendMessage" /><button class="send-button" bindtap="sendMessage" disabled="{{!draft || thinking}}"><text>➤</text></button></view>
    <text class="privacy-note">不发送日记正文 · 仅用于提供个性化建议</text>
  </view>
</view>
