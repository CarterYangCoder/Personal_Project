.launch { position: relative; width: 100%; height: 100vh; overflow: hidden; background-color: #f7f1e6; transition: opacity .25s ease, transform .25s ease; }
.launch-art { position: absolute; right: -360rpx; bottom: -40rpx; width: 1500rpx; height: 1160rpx; transform: rotate(-3deg); }
.launch-wash { position: absolute; top: 0; right: 0; left: 0; height: 860rpx; background-image: linear-gradient(180deg, rgba(218,235,229,.94) 0%, rgba(247,241,230,.96) 42%, rgba(247,241,230,.52) 100%); }
.launch-copy { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; padding-top: 330rpx; }
.seal { display: flex; flex-direction: column; align-items: center; width: 70rpx; padding: 10rpx 0 7rpx; border: 3rpx solid #08777d; border-radius: 36rpx; color: #08777d; }
.seal text { font-family: "STKaiti", serif; font-size: 25rpx; line-height: 1.15; }
.seal view { width: 29rpx; height: 3rpx; margin-top: 6rpx; background-color: #08777d; }
.launch-title { margin-top: 42rpx; color: #063f50; font-family: "Songti SC", "STSong", serif; font-size: 70rpx; font-weight: 700; letter-spacing: 8rpx; }
.launch-subtitle { margin-top: 24rpx; color: #6f7777; font-size: 25rpx; letter-spacing: 4rpx; }
.summer-mark { display: flex; flex-direction: row; align-items: center; margin-top: 34rpx; }
.summer-mark view { width: 78rpx; height: 1px; background-color: #789597; }
.summer-mark text { margin: 0 20rpx; color: #2c6a75; font-size: 18rpx; letter-spacing: 7rpx; }
.launch-bottom { position: absolute; z-index: 3; right: 0; bottom: calc(64rpx + env(safe-area-inset-bottom)); left: 0; display: flex; flex-direction: column; align-items: center; color: #ffffff; }
.launch-chevron { font-size: 58rpx; line-height: .7; }
.launch-enter { margin-top: 20rpx; font-size: 24rpx; letter-spacing: 4rpx; }
.leaving { opacity: 0; transform: scale(1.025); }
