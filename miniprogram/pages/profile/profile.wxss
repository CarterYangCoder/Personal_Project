.profile-content { display: flex; flex-direction: column; padding: 0 30rpx calc(50rpx + env(safe-area-inset-bottom)); }
.profile-avatar { position: relative; z-index: 4; width: 210rpx; height: 210rpx; margin: -86rpx auto 0; overflow: visible; border: 10rpx solid #fffdf8; border-radius: 50%; background-color: #dceae7; box-shadow: 0 12rpx 30rpx rgba(31, 72, 78, .14); }
.profile-avatar > image { width: 190rpx; height: 190rpx; border-radius: 50%; }
.profile-camera { position: absolute; right: -13rpx; bottom: 7rpx; display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border: 6rpx solid #fffdf8; border-radius: 50%; background-color: #ffffff; }
.profile-camera image { width: 42rpx; height: 42rpx; }
.change-avatar { margin-top: 18rpx; color: #356a77; font-size: 26rpx; text-align: center; }
.profile-label { margin: 31rpx 10rpx 12rpx; font-family: "Songti SC", serif; font-size: 27rpx; font-weight: 700; }
.profile-input-row { display: flex; flex-direction: row; align-items: center; height: 96rpx; padding: 0 26rpx; }
.profile-input { flex: 1; height: 96rpx; color: #073f50; font-size: 31rpx; }
.profile-input-row > text { color: #96a0a5; font-size: 22rpx; }
.identity-card { position: relative; height: 330rpx; margin-top: 32rpx; overflow: hidden; padding: 30rpx; }
.identity-art { position: absolute; right: -210rpx; bottom: -55rpx; width: 900rpx; height: 338rpx; }
.identity-shade { position: absolute; top: 0; right: 0; left: 0; height: 180rpx; background-image: linear-gradient(180deg, rgba(255,253,248,.98) 0%, rgba(255,253,248,.45) 100%); }
.identity-title { position: relative; z-index: 2; font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 700; }
.identity-body { position: relative; z-index: 2; display: flex; flex-direction: row; align-items: center; margin-top: 28rpx; }
.identity-avatar { width: 128rpx; height: 128rpx; border: 7rpx solid #fff; border-radius: 50%; }
.identity-copy { display: flex; flex-direction: column; margin-left: 28rpx; }
.identity-name { font-family: "Songti SC", serif; font-size: 40rpx; font-weight: 700; }
.identity-note { margin-top: 8rpx; color: #587683; font-size: 24rpx; }
.privacy { margin: 42rpx 0 28rpx; color: #7a8d96; font-size: 22rpx; text-align: center; }
.profile-bottom-art { width: calc(100% + 60rpx); height: 180rpx; margin: 30rpx -30rpx -50rpx; }
