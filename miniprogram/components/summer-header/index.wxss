.summer-header { position: relative; height: 356rpx; overflow: hidden; background-color: #f7f1e6; }
.summer-header.compact { height: 300rpx; }
.header-art { position: absolute; right: 0; bottom: 0; left: 0; width: 100%; height: 330rpx; }
.header-shade { position: absolute; top: 0; right: 0; left: 0; height: 190rpx; background-image: linear-gradient(180deg, rgba(247,241,230,.98) 0%, rgba(247,241,230,.74) 62%, rgba(247,241,230,0) 100%); }
.header-copy { position: relative; z-index: 2; display: flex; flex-direction: row; align-items: flex-start; padding: 44rpx 42rpx 0; }
.header-back { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 70rpx; margin-right: 14rpx; color: #073f50; }
.header-back text { font-size: 74rpx; line-height: 1; }
.header-text { display: flex; flex-direction: column; min-width: 0; padding-top: 4rpx; }
.header-title { color: #073f50; font-family: "Songti SC", "STSong", serif; font-size: 54rpx; font-weight: 700; line-height: 1.2; letter-spacing: 4rpx; }
.header-subtitle { max-width: 500rpx; margin-top: 15rpx; color: #285d6c; font-family: "Kaiti SC", "STKaiti", serif; font-size: 25rpx; line-height: 1.65; letter-spacing: 2rpx; }
