<navigation-bar title="暑假一起过" background="#f3efe5" color="#263f38"></navigation-bar>
<scroll-view class="study-page" scroll-y scroll-with-animation scroll-into-view="{{scrollTarget}}">
  <view wx:if="{{!isLoggedIn}}" class="guest-module page-shell">
    <view class="eyebrow">DAILY STUDY LOG</view><view class="page-title">把每天学过的，<br/>慢慢变成自己的。</view>
    <view class="page-subtitle">登录后可以按日期、时间和学科记录学习安排、过程和复盘，持续积累属于你的学习手账。</view><view class="guest-icon">📚</view>
    <button bindtap="goLogin">登录后开始记录</button>
  </view>

  <block wx:else>
    <view class="study-hero"><view class="hero-ring"></view><view class="hero-kicker">DAILY STUDY LOG / 2026</view><view class="hero-title">我的每日<br/>学习手账</view><view class="hero-note">学习不只是一张待办单。把时间、内容、感受和收获都留在这里。</view><view class="hero-symbol" bindtap="toggleWink">{{wink ? '✦' : '✎'}}</view></view>

    <view class="page-shell study-body">
      <view class="study-summary"><view><text>{{todayCount}}</text><view>今天记录</view></view><view><text>{{openTasks}}</text><view>还在学习</view></view><view><text>{{completedCount}}</text><view>已经完成</view></view></view>

      <view class="section-head"><view class="section-title">记一段学习安排</view><view class="section-link">{{editingId ? '正在编辑' : '随时补记'}}</view></view>
      <view id="study-form" class="study-board surface">
        <form bindsubmit="saveTask">
          <view class="form-heading"><view><text>{{editingId ? '修改这条记录' : '今天想学什么？'}}</text><view>可以只记一件事，也可以把目标、过程和复盘都写下来</view></view><view wx:if="{{editingId}}" class="cancel-edit" bindtap="cancelEdit">取消编辑</view></view>
          <view class="field-label">学习标题 <text>必填</text></view><input class="study-field title-field" value="{{studyTitle}}" bindinput="inputStudyTitle" maxlength="50" placeholder="例如：完成数据结构第 3 章习题" />
          <view class="field-label">日期与时间</view><view class="date-time-row"><picker class="date-picker" mode="date" value="{{studyDate}}" bindchange="changeStudyDate"><view class="study-field compact-field"><text>日期</text>{{studyDate}}⌄</view></picker><view class="time-pair"><picker mode="time" value="{{startTime}}" bindchange="changeStartTime"><view class="study-field compact-field">{{startTime}}</view></picker><text>—</text><picker mode="time" value="{{endTime}}" bindchange="changeEndTime"><view class="study-field compact-field">{{endTime}}</view></picker></view></view>
          <view class="field-label">学科 / 分类</view><input class="study-field" value="{{subject}}" bindinput="inputSubject" maxlength="20" placeholder="例如：英语、专业课、阅读、技能练习" />
          <view class="field-label">学习内容与目标</view><textarea class="study-field study-textarea" value="{{details}}" bindinput="inputDetails" maxlength="500" placeholder="准备学哪些内容？想达到什么程度？"></textarea>
          <view class="field-label">收获与复盘</view><textarea class="study-field result-textarea" value="{{result}}" bindinput="inputResult" maxlength="300" placeholder="学到了什么，哪里还需要继续？"></textarea>
          <view class="picker-row"><picker range="{{quadrantNames}}" value="{{quadrantIndex}}" bindchange="changeQuadrant"><view class="choice-select">优先级 · {{quadrantNames[quadrantIndex]}}⌄</view></picker><picker range="{{visibilityOptions}}" value="{{visibilityIndex}}" bindchange="changeVisibility"><view class="choice-select">{{visibilityOptions[visibilityIndex]}}⌄</view></picker></view>
          <view class="form-bottom"><picker class="status-picker" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="changeStatus"><view class="status-select">状态 · {{statusOptions[statusIndex]}}⌄</view></picker><button class="save-study" form-type="submit">{{editingId ? '保存修改' : '保存这条记录'}}</button></view>
        </form>
      </view>

      <view class="section-head"><view class="section-title">我的学习日历</view><view class="section-link">{{tasks.length}} 条记录</view></view>
      <view wx:if="{{!taskGroups.length}}" class="journal-empty surface"><view>📝</view><text>今天还没有学习记录</text><view>读几页书、看一节课，也值得被记下来。</view></view>
      <view class="day-group" wx:for="{{taskGroups}}" wx:key="date" wx:for-item="group"><view class="day-heading"><view>{{group.label}}</view><text>{{group.items.length}} 项学习</text></view><view class="day-timeline"><view class="study-record" wx:for="{{group.items}}" wx:key="id" wx:for-item="task"><view class="time-column"><text>{{task.startTime || '—'}}</text><view></view></view><view class="record-card surface {{task.statusKey}}"><view class="record-top"><view class="subject-tag">{{task.subject}}</view><view class="status-tag" bindtap="cycleStatus" data-id="{{task.id}}">{{task.status}} ↻</view></view><view class="record-title">{{task.title}}</view><view wx:if="{{task.details}}" class="record-details">{{task.details}}</view><view wx:if="{{task.result}}" class="record-result"><text>收获 / 复盘</text><view>{{task.result}}</view></view><view class="record-footer"><text>{{task.timeLabel}} · {{task.visibility}}</text><view><text bindtap="editTask" data-id="{{task.id}}">编辑</text><text bindtap="deleteTask" data-id="{{task.id}}">删除</text></view></view></view></view></view></view>

      <view class="section-head"><view class="section-title">优先级一览</view><view class="section-link" bindtap="sharePlan">复制学习摘要</view></view>
      <view class="quadrant-grid"><view class="quadrant {{item.tone}}" wx:for="{{quadrants}}" wx:key="key"><view class="quadrant-head"><view><text>{{item.index}}</text>{{item.name}}</view><view>{{item.items.length}}</view></view><view wx:if="{{!item.items.length}}" class="quadrant-empty">暂时没有安排</view><view wx:for="{{item.items}}" wx:key="id" wx:for-item="task" class="quadrant-task {{task.done ? 'finished' : ''}}">{{task.done ? '✓ ' : ''}}{{task.title}}</view></view></view>

      <view class="section-head"><view class="section-title">自定义番茄钟</view><view class="section-link">专注第 {{rounds + 1}} 轮</view></view>
      <view class="timer-card surface {{timerMode}}"><view class="timer-mode">{{timerMode === 'focus' ? '深度学习' : '休息一下'}}</view><view class="timer-text">{{timerText}}</view><view class="timer-settings"><view><text>专注分钟</text><input type="number" value="{{focusMinutes}}" disabled="{{timerRunning}}" bindblur="changeFocusMinutes" /></view><view><text>休息分钟</text><input type="number" value="{{restMinutes}}" disabled="{{timerRunning}}" bindblur="changeRestMinutes" /></view></view><view class="timer-actions"><button class="secondary-button" bindtap="resetTimer">重置</button><button class="primary-button" bindtap="toggleTimer">{{timerRunning ? '暂停' : '开始专注'}}</button></view></view>
      <view class="study-ending">计划可以松一点，开始要认真一点。</view>
    </view>
  </block>
</scroll-view>
