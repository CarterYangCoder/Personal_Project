.study-page { height: 100vh; color: #33445a; background: #edf4ff; }
.study-top { display: flex; justify-content: space-between; align-items: center; }.study-mark { color: #7994b5; font-size: 18rpx; letter-spacing: 2rpx; }
.study-hero { display: flex; align-items: center; gap: 24rpx; margin-top: 48rpx; }.study-emoji { flex: none; font-size: 82rpx; }.study-hero .page-title { font-size: 41rpx; line-height: 1.35; }.hero-note { margin-top: 13rpx; color: #78899f; font-size: 22rpx; line-height: 1.6; }
.quadrant-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; }.quadrant { min-height: 250rpx; padding: 21rpx; border-radius: 24rpx; }.quadrant.red { background: #ffe9e5; }.quadrant.blue { background: #e1ebff; }.quadrant.orange { background: #fff0dc; }.quadrant.green { background: #e2f2e7; }
.quadrant-head { display: flex; justify-content: space-between; color: #506176; font-size: 22rpx; font-weight: 700; }.quadrant-head text { margin-right: 8rpx; color: #8c9bad; font-size: 17rpx; }.task-empty { margin-top: 42rpx; color: #9ba8b6; font-size: 19rpx; text-align: center; }
.task-item { position: relative; margin-top: 14rpx; padding: 14rpx 28rpx 14rpx 48rpx; border-radius: 14rpx; background: rgba(255,255,255,.55); }.task-check { position: absolute; top: 17rpx; left: 13rpx; display: flex; align-items: center; justify-content: center; width: 23rpx; height: 23rpx; border: 2rpx solid #8ea3bf; border-radius: 50%; color: #fff; font-size: 15rpx; }.task-title { color: #4a5c70; font-size: 20rpx; line-height: 1.4; }.task-meta { margin-top: 5rpx; color: #98a4b0; font-size: 16rpx; }.task-delete { position: absolute; top: 9rpx; right: 10rpx; color: #a7a7a7; font-size: 25rpx; }.task-finished .task-check { border-color: #668eb8; background: #668eb8; }.task-finished .task-title { color: #99a7b6; text-decoration: line-through; }
.plan-form { margin-top: 22rpx; padding: 27rpx; box-shadow: none; }.form-title { margin-bottom: 18rpx; color: #42566d; font-size: 26rpx; font-weight: 700; }.field { width: 100%; min-height: 78rpx; padding: 18rpx; border: 1rpx solid #dfe7f1; border-radius: 16rpx; color: #42566d; font-size: 22rpx; background: #f9fbff; }.picker-row { display: flex; gap: 13rpx; margin-top: 13rpx; }.picker { flex: 1; min-width: 0; }.picker-field { display: flex; align-items: center; font-size: 19rpx; }.add-button { height: 82rpx; margin-top: 18rpx; border-radius: 41rpx; color: #fff; font-size: 24rpx; line-height: 82rpx; background: #5579b8; }.plan-tools { display: flex; align-items: center; gap: 12rpx; margin-top: 13rpx; }.privacy-tip { flex: 1; color: #a0aabc; font-size: 18rpx; line-height: 1.5; }.share-plan { flex: none; padding: 10rpx 13rpx; border-radius: 12rpx; color: #567cae; font-size: 18rpx; background: #e7effc; }
.timer-card { padding: 34rpx; text-align: center; box-shadow: none; background: linear-gradient(145deg, #fff, #e7effc); }.timer-card.rest { background: linear-gradient(145deg, #fff, #e5f3e8); }.timer-mode { color: #6e83a2; font-size: 22rpx; letter-spacing: 2rpx; }.timer-text { margin-top: 13rpx; color: #344d6d; font-size: 94rpx; font-weight: 700; letter-spacing: 3rpx; }.timer-settings { display: flex; justify-content: center; gap: 25rpx; margin-top: 12rpx; }.timer-settings view { display: flex; align-items: center; gap: 8rpx; color: #7b899c; font-size: 19rpx; }.timer-settings input { width: 75rpx; height: 50rpx; border-radius: 12rpx; color: #496484; background: rgba(255,255,255,.75); }.timer-actions { display: flex; gap: 14rpx; margin-top: 28rpx; }.timer-actions button { flex: 1; height: 78rpx; border-radius: 39rpx; font-size: 22rpx; line-height: 78rpx; }.secondary-button { color: #667c99; background: #e8eef7; }.primary-button { color: #fff; background: #4e72ad; }.study-ending { margin: 45rpx 20rpx 5rpx; color: #8291a5; font-size: 22rpx; line-height: 1.7; text-align: center; }
.study-page { color: #334b46; background: #f5f8f6; }.study-hero { margin-top: 38rpx; }.study-emoji { font-size: 68rpx; }.study-hero .page-title { color: #304841; font-size: 39rpx; }.hero-note { color: #758a84; }.quadrant { min-height: 230rpx; border-radius: 20rpx; }.quadrant.red, .quadrant.blue, .quadrant.orange, .quadrant.green { background: #fff; }.quadrant.red { border-top: 6rpx solid #ed9e90; }.quadrant.blue { border-top: 6rpx solid #83acc9; }.quadrant.orange { border-top: 6rpx solid #e9bd78; }.quadrant.green { border-top: 6rpx solid #79b69a; }.add-button, .primary-button { background: #438d81; }.timer-card { border-radius: 24rpx; background: #fff; }.timer-card.rest { background: #fff; }.timer-text { color: #37675d; }
.study-login-lock { margin-top: 42rpx; padding: 34rpx; color: #55746c; font-size: 27rpx; font-weight: 700; }.study-login-lock text { display: block; margin-top: 16rpx; color: #879c95; font-size: 21rpx; font-weight: 400; line-height: 1.7; }

/* 学习页：书院案头 */
.study-page { background: linear-gradient(180deg, #e9e1d2 0, #f3efe5 420rpx); }
.study-mark { padding: 7rpx 12rpx; border: 2rpx solid #9d3e35; color: #963c33; letter-spacing: 3rpx; }
.study-hero { position: relative; min-height: 245rpx; margin-top: 34rpx; padding: 35rpx 30rpx; border: 1rpx solid #d9cbb4; border-radius: 16rpx; background: rgba(255,252,244,.82); box-shadow: 0 13rpx 30rpx rgba(62,51,35,.06); }
.study-emoji { font-size: 74rpx; }.study-hero .page-title { color: #263f38; font-size: 40rpx; }.hero-note { color: #817e74; }
.quadrant-grid { gap: 18rpx; }.quadrant { min-height: 265rpx; padding: 24rpx; border: 1rpx solid #e0d5c2; border-radius: 12rpx; background: #fffdf7 !important; box-shadow: 0 9rpx 24rpx rgba(59,48,32,.04); }
.quadrant.red { border-top: 7rpx solid #9e3c33; }.quadrant.blue { border-top: 7rpx solid #46665e; }.quadrant.orange { border-top: 7rpx solid #af7946; }.quadrant.green { border-top: 7rpx solid #728a69; }
.quadrant-head { color: #314941; }.task-item { background: #f4eee2; }.task-title { color: #4b524b; }.task-check { border-color: #9d6b55; }
.plan-form, .timer-card { border-radius: 16rpx; background: #fffdf7; }.field { border-color: #e0d5c2; border-radius: 8rpx; background: #faf6ed; }
.add-button, .primary-button { border-radius: 8rpx; background: #8f372f; }.share-plan { border-radius: 5rpx; color: #7b3d35; background: #eee3d3; }
.timer-text { color: #214b42; font-family: Georgia, serif; }.timer-settings input { border: 1rpx solid #ddd1bc; border-radius: 6rpx; background: #f7f0e4; }.secondary-button { border-radius: 8rpx !important; color: #5f6259; background: #ebe3d5; }
.study-ending { color: #805047; font-size: 23rpx; }.study-login-lock { border-radius: 14rpx; background: #fffdf7; }
