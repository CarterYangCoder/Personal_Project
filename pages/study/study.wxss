.study-page { height: 100vh; color: #314941; background: radial-gradient(circle at 88% 3%, rgba(151, 62, 52, .09), transparent 21%), #f3efe5; }
.study-hero { position: relative; min-height: 310rpx; overflow: hidden; padding: 46rpx 48rpx 38rpx; color: #fff7e7; background: #244c43; }
.hero-ring { position: absolute; top: -95rpx; right: -42rpx; width: 330rpx; height: 330rpx; border: 1rpx solid rgba(255,255,255,.22); border-radius: 50%; box-shadow: 0 0 0 38rpx rgba(255,255,255,.04), 0 0 0 76rpx rgba(255,255,255,.03); }
.hero-kicker { position: relative; color: #d9bd86; font-size: 18rpx; letter-spacing: 3rpx; }.hero-title { position: relative; margin-top: 16rpx; font-family: Georgia, "STKaiti", serif; font-size: 53rpx; line-height: 1.18; letter-spacing: 3rpx; }.hero-note { position: relative; width: 550rpx; margin-top: 17rpx; color: #d4ddd3; font-size: 21rpx; line-height: 1.65; }.hero-symbol { position: absolute; right: 58rpx; bottom: 48rpx; color: #d8b374; font-size: 52rpx; }
.study-body { padding-bottom: 72rpx; }.study-summary { display: flex; margin-top: -26rpx; padding: 23rpx 16rpx; border: 1rpx solid #e0d6c4; border-radius: 14rpx; background: #fffdf7; box-shadow: 0 12rpx 28rpx rgba(54,48,36,.08); }.study-summary > view { flex: 1; color: #8a7b69; font-size: 18rpx; text-align: center; }.study-summary > view + view { border-left: 1rpx solid #ece4d7; }.study-summary text { display: block; margin-bottom: 8rpx; color: #27544a; font-family: Georgia, serif; font-size: 40rpx; }
.study-board { padding: 30rpx; border-radius: 16rpx; background: #fffdf7; box-shadow: 0 10rpx 28rpx rgba(62,52,38,.05); }.form-heading { display: flex; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; }.form-heading > view:first-child > text { color: #314941; font-size: 28rpx; font-weight: 700; }.form-heading > view:first-child > view { margin-top: 8rpx; color: #8b8478; font-size: 19rpx; line-height: 1.5; }.cancel-edit { flex: none; padding: 9rpx 12rpx; color: #914037; font-size: 19rpx; background: #f4e7d9; }
.field-label { margin: 22rpx 0 10rpx; color: #5c6159; font-size: 21rpx; font-weight: 700; }.field-label text { margin-left: 8rpx; color: #a34b41; font-size: 17rpx; font-weight: 400; }.study-field { box-sizing: border-box; width: 100%; min-height: 76rpx; padding: 18rpx; border: 1rpx solid #e0d5c2; border-radius: 8rpx; color: #3e514b; font-size: 22rpx; background: #faf6ed; }.title-field { font-size: 25rpx; font-weight: 700; }.date-time-row { display: flex; align-items: center; gap: 12rpx; }.date-picker { flex: 1; min-width: 0; }.compact-field { display: flex; align-items: center; justify-content: space-between; min-height: 68rpx; padding: 13rpx; font-size: 19rpx; }.compact-field text { margin-right: 8rpx; color: #9a8d7a; }.time-pair { display: flex; align-items: center; gap: 8rpx; color: #998b79; font-size: 20rpx; }.time-pair .compact-field { min-width: 88rpx; justify-content: center; }.study-textarea { height: 166rpx; line-height: 1.6; }.result-textarea { height: 126rpx; line-height: 1.6; }.picker-row { display: flex; gap: 12rpx; margin-top: 18rpx; }.picker-row picker { flex: 1; min-width: 0; }.choice-select, .status-select { min-height: 62rpx; padding: 0 15rpx; border: 1rpx solid #dfd4c0; border-radius: 7rpx; color: #665e52; font-size: 18rpx; line-height: 62rpx; background: #f5efe3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.form-bottom { display: flex; gap: 14rpx; align-items: center; margin-top: 22rpx; }.status-picker { flex: 1; min-width: 0; }.save-study { flex: 1.2; height: 72rpx; margin: 0; border-radius: 8rpx; color: #fff; font-size: 21rpx; line-height: 72rpx; background: #913b33; }
.journal-empty { padding: 50rpx 25rpx; border-radius: 16rpx; color: #7e8279; font-size: 21rpx; text-align: center; background: #fffdf7; }.journal-empty > view:first-child { margin-bottom: 10rpx; font-size: 42rpx; }.journal-empty text { display: block; color: #475c55; font-size: 26rpx; font-weight: 700; }.journal-empty > view:last-child { margin-top: 10rpx; }
.day-group { margin-top: 28rpx; }.day-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 13rpx; color: #31564d; font-size: 25rpx; font-weight: 700; }.day-heading text { color: #a07963; font-size: 18rpx; font-weight: 400; }.day-timeline { padding-left: 8rpx; }.study-record { display: flex; gap: 13rpx; }.time-column { flex: none; width: 77rpx; color: #8c755f; font-size: 18rpx; text-align: right; }.time-column > view { width: 14rpx; height: 14rpx; margin: 12rpx -7rpx 0 auto; border: 4rpx solid #e9ded0; border-radius: 50%; background: #a3483f; box-sizing: border-box; }.record-card { flex: 1; min-width: 0; margin: 0 0 17rpx; padding: 24rpx; border-left: 5rpx solid #b18a55; border-radius: 12rpx; background: #fffdf7; box-shadow: 0 7rpx 20rpx rgba(62,52,38,.04); }.record-card.doing { border-left-color: #3b796c; }.record-card.done { border-left-color: #9aab7a; opacity: .83; }.record-top, .record-footer { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }.subject-tag { max-width: 250rpx; padding: 6rpx 10rpx; color: #725739; font-size: 17rpx; background: #f2e7d7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.status-tag { flex: none; color: #8d4038; font-size: 18rpx; }.record-card.doing .status-tag { color: #287166; }.record-card.done .status-tag { color: #6f865b; }.record-title { margin-top: 14rpx; color: #2e4840; font-size: 27rpx; font-weight: 700; line-height: 1.45; }.record-details { margin-top: 11rpx; color: #71766e; font-size: 20rpx; line-height: 1.65; white-space: pre-wrap; }.record-result { margin-top: 14rpx; padding: 13rpx; color: #677069; font-size: 19rpx; line-height: 1.55; background: #f8f2e8; }.record-result text { display: block; margin-bottom: 5rpx; color: #9b765a; font-size: 17rpx; }.record-footer { margin-top: 17rpx; padding-top: 13rpx; border-top: 1rpx solid #eee5d8; color: #9a8e80; font-size: 17rpx; }.record-footer > view { display: flex; gap: 16rpx; color: #8e4037; }
.quadrant-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.quadrant { min-height: 176rpx; padding: 21rpx; border: 1rpx solid #e2d8c6; border-top: 6rpx solid #a04940; border-radius: 12rpx; background: #fffdf7; }.quadrant.blue { border-top-color: #4a7770; }.quadrant.orange { border-top-color: #ad7a48; }.quadrant.green { border-top-color: #7e9970; }.quadrant-head { display: flex; justify-content: space-between; color: #3e554e; font-size: 20rpx; font-weight: 700; }.quadrant-head text { margin-right: 7rpx; color: #9a765b; font-family: Georgia, serif; }.quadrant-empty { margin-top: 45rpx; color: #a29b90; font-size: 18rpx; text-align: center; }.quadrant-task { margin-top: 12rpx; color: #667069; font-size: 18rpx; line-height: 1.45; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.quadrant-task.finished { color: #a0a69a; text-decoration: line-through; }
.timer-card { padding: 34rpx; border-radius: 16rpx; text-align: center; background: #fffdf7; }.timer-mode { color: #9a7659; font-size: 19rpx; letter-spacing: 3rpx; }.timer-text { margin-top: 12rpx; color: #234b43; font-family: Georgia, serif; font-size: 86rpx; font-weight: 700; letter-spacing: 3rpx; }.timer-settings { display: flex; justify-content: center; gap: 23rpx; margin-top: 12rpx; }.timer-settings view { display: flex; align-items: center; gap: 8rpx; color: #7e8178; font-size: 18rpx; }.timer-settings input { width: 74rpx; height: 50rpx; border: 1rpx solid #ddd1bc; border-radius: 6rpx; color: #355e55; background: #f7f0e4; }.timer-actions { display: flex; gap: 14rpx; margin-top: 26rpx; }.timer-actions button { flex: 1; height: 72rpx; border-radius: 8rpx; font-size: 21rpx; line-height: 72rpx; }.secondary-button { color: #5f6259; background: #ebe3d5; }.primary-button { color: #fff; background: #234b43; }.study-ending { margin: 46rpx 0 8rpx; color: #8b6d59; font-size: 21rpx; text-align: center; }
.guest-module { padding-top: 96rpx; }.guest-module .guest-icon { margin-top: 70rpx; font-size: 100rpx; text-align: center; }.guest-module button { height: 82rpx; margin-top: 64rpx; border-radius: 8rpx; color: #fff; font-size: 24rpx; line-height: 82rpx; background: #234b43; }
