.daily-page { height: 100vh; color: #314941; background: radial-gradient(circle at 90% 5%, rgba(159,59,49,.10), transparent 20%), #f3efe5; }
.daily-hero { position: relative; min-height: 310rpx; overflow: hidden; padding: 46rpx 48rpx 38rpx; color: #fff7e7; background: #833e36; }.hero-orbit { position: absolute; top: -92rpx; right: -35rpx; width: 335rpx; height: 335rpx; border: 1rpx solid rgba(255,255,255,.22); border-radius: 50%; box-shadow: 0 0 0 36rpx rgba(255,255,255,.04), 0 0 0 74rpx rgba(255,255,255,.03); }.hero-kicker { position: relative; color: #e6c998; font-size: 18rpx; letter-spacing: 3rpx; }.hero-title { position: relative; margin-top: 16rpx; font-family: Georgia, "STKaiti", serif; font-size: 53rpx; line-height: 1.18; letter-spacing: 3rpx; }.hero-note { position: relative; width: 540rpx; margin-top: 17rpx; color: #f2ddd0; font-size: 21rpx; line-height: 1.65; }.hero-flower { position: absolute; right: 55rpx; bottom: 47rpx; color: #f0c98d; font-size: 53rpx; }
.daily-body { padding-bottom: 76rpx; }.daily-summary { display: flex; margin-top: -26rpx; padding: 23rpx 16rpx; border: 1rpx solid #e0d6c4; border-radius: 14rpx; background: #fffdf7; box-shadow: 0 12rpx 28rpx rgba(54,48,36,.08); }.daily-summary > view { flex: 1; color: #8a7b69; font-size: 18rpx; text-align: center; }.daily-summary > view + view { border-left: 1rpx solid #ece4d7; }.daily-summary text { display: block; margin-bottom: 8rpx; color: #8d3b33; font-family: Georgia, serif; font-size: 40rpx; }
.diary-form { padding: 30rpx; border-radius: 16rpx; background: #fffdf7; box-shadow: 0 10rpx 28rpx rgba(62,52,38,.05); }.form-heading { display: flex; justify-content: space-between; gap: 18rpx; margin-bottom: 23rpx; }.form-heading > view:first-child > text { color: #314941; font-size: 28rpx; font-weight: 700; }.form-heading > view:first-child > view { margin-top: 8rpx; color: #8b8478; font-size: 19rpx; line-height: 1.5; }.cancel-edit { flex: none; padding: 9rpx 12rpx; color: #914037; font-size: 19rpx; background: #f4e7d9; }.field-label { margin: 22rpx 0 10rpx; color: #5c6159; font-size: 21rpx; font-weight: 700; }.field-label text { margin-left: 8rpx; color: #a34b41; font-size: 17rpx; font-weight: 400; }
.schedule-row { display: flex; gap: 12rpx; }.schedule-row picker { flex: 1; }.date-field { min-height: 68rpx; padding: 0 14rpx; border: 1rpx solid #e2d7c3; border-radius: 7rpx; color: #655e53; font-size: 19rpx; line-height: 68rpx; text-align: center; background: #f5efe3; }.mood-picker { display: block; margin-top: 12rpx; }.mood-picker .date-field { text-align: left; }.diary-field { box-sizing: border-box; width: 100%; min-height: 76rpx; padding: 18rpx; border: 1rpx solid #e0d5c2; border-radius: 8rpx; color: #3e514b; font-size: 22rpx; background: #faf6ed; }.title-field { font-size: 25rpx; font-weight: 700; }.diary-content-input { height: 190rpx; line-height: 1.65; }.important-row { display: flex; justify-content: space-between; align-items: center; margin-top: 17rpx; padding: 18rpx 0; border-top: 1rpx solid #e8decd; color: #4e625d; font-size: 22rpx; }.important-row text { display: block; margin-top: 5rpx; color: #9ba5a2; font-size: 18rpx; }.save-button { height: 74rpx; margin-top: 14rpx; border-radius: 8rpx; color: #fff; font-size: 22rpx; line-height: 74rpx; background: #913b33; }
.journal-empty { padding: 50rpx 25rpx; border-radius: 16rpx; color: #7e8279; font-size: 21rpx; text-align: center; background: #fffdf7; }.journal-empty > view:first-child { margin-bottom: 10rpx; font-size: 42rpx; }.journal-empty text { display: block; color: #475c55; font-size: 26rpx; font-weight: 700; }.journal-empty > view:last-child { margin-top: 10rpx; }
.day-group { margin-top: 28rpx; }.day-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 13rpx; color: #31564d; font-size: 25rpx; font-weight: 700; }.day-heading text { color: #a07963; font-size: 18rpx; font-weight: 400; }.day-timeline { padding-left: 8rpx; }.diary-record { display: flex; gap: 13rpx; }.time-column { flex: none; width: 77rpx; color: #8c755f; font-size: 18rpx; text-align: right; }.time-column > view { width: 14rpx; height: 14rpx; margin: 12rpx -7rpx 0 auto; border: 4rpx solid #e9ded0; border-radius: 50%; background: #a3483f; box-sizing: border-box; }.record-card { flex: 1; min-width: 0; margin: 0 0 17rpx; padding: 24rpx; border-left: 5rpx solid #b18a55; border-radius: 12rpx; background: #fffdf7; box-shadow: 0 7rpx 20rpx rgba(62,52,38,.04); }.record-card.important { border-left-color: #913b33; }.record-top, .record-footer { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }.category-tag { max-width: 230rpx; padding: 6rpx 10rpx; color: #725739; font-size: 17rpx; background: #f2e7d7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.mood-tag { flex: none; color: #8b7767; font-size: 18rpx; }.record-title { margin-top: 14rpx; color: #2e4840; font-size: 27rpx; font-weight: 700; line-height: 1.45; }.record-content { margin-top: 11rpx; color: #71766e; font-size: 20rpx; line-height: 1.7; white-space: pre-wrap; }.record-footer { margin-top: 17rpx; padding-top: 13rpx; border-top: 1rpx solid #eee5d8; color: #9a8e80; font-size: 17rpx; }.record-footer > view { display: flex; gap: 16rpx; color: #8e4037; }
.song-card { display: flex; gap: 25rpx; align-items: center; min-height: 260rpx; padding: 31rpx; border-radius: 16rpx; background: linear-gradient(135deg, #243f3b, #395b52); box-shadow: 0 16rpx 38rpx rgba(35,53,47,.15); }.record { display: flex; flex: none; align-items: center; justify-content: center; width: 178rpx; height: 178rpx; border: 23rpx solid #111d1c; border-radius: 50%; background: repeating-radial-gradient(circle, #263b3f 0, #263b3f 4rpx, #40585b 5rpx, #40585b 7rpx); box-shadow: 0 0 0 8rpx rgba(255,255,255,.06); }.record-center { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 50%; color: #6f312c; font-size: 29rpx; background: #c69755; }.song-copy { flex: 1; min-width: 0; }.song-label { color: #d2b47f; font-size: 16rpx; letter-spacing: 2rpx; }.song-title { margin-top: 8rpx; color: #fff7e7; font-size: 31rpx; font-weight: 700; }.song-artist { margin-top: 5rpx; color: #c8cdc5; font-size: 20rpx; }.song-note { margin-top: 12rpx; color: #c8cdc5; font-size: 19rpx; line-height: 1.55; }.song-actions { display: flex; gap: 10rpx; }.song-actions button { width: fit-content; height: 52rpx; margin: 13rpx 0 0; padding: 0 14rpx; border: 1rpx solid rgba(226,207,172,.25); border-radius: 26rpx; color: #ebd4ad; font-size: 18rpx; line-height: 52rpx; background: rgba(255,255,255,.08); }.song-actions .saved { color: #ffe2cd; background: #873a33; }.last-line { margin: 60rpx 0 15rpx; color: #8d382f; font-family: "STKaiti", "KaiTi", serif; font-size: 37rpx; line-height: 1.45; letter-spacing: 4rpx; text-align: center; }
.guest-module { padding-top: 96rpx; }.guest-module .guest-icon { margin-top: 70rpx; color: #933e35; font-size: 100rpx; text-align: center; }.guest-module button { height: 82rpx; margin-top: 64rpx; border-radius: 8rpx; color: #fff; font-size: 24rpx; line-height: 82rpx; background: #913b33; }
