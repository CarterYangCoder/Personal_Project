.daily-page { height: 100vh; }.daily-top { display: flex; justify-content: space-between; align-items: flex-start; }.daily-lead { margin-top: 38rpx; color: #61766f; font-size: 29rpx; line-height: 1.7; }
.song-card { display: flex; gap: 27rpx; align-items: center; padding: 30rpx; background: linear-gradient(135deg, #fff5dc, #fff); }.record { display: flex; align-items: center; justify-content: center; flex: none; width: 190rpx; height: 190rpx; border: 25rpx solid #344d51; border-radius: 50%; background: repeating-radial-gradient(circle, #263b3f 0, #263b3f 4rpx, #40585b 5rpx, #40585b 7rpx); }.record-center { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border-radius: 50%; color: #765338; font-size: 31rpx; background: #f3bc6a; }.song-copy { flex: 1; min-width: 0; }.song-label { color: #c18b4d; font-size: 16rpx; letter-spacing: 2rpx; }.song-title { margin-top: 9rpx; color: #384d4b; font-size: 33rpx; font-weight: 700; }.song-artist { margin-top: 5rpx; color: #87918e; font-size: 20rpx; }.song-note { margin-top: 13rpx; color: #6e7b77; font-size: 20rpx; line-height: 1.55; }.change-song { width: fit-content; height: 55rpx; margin: 14rpx 0 0; padding: 0 19rpx; border-radius: 28rpx; color: #af7541; font-size: 19rpx; line-height: 55rpx; background: #fff0d6; }
.diary-form { padding: 28rpx; box-shadow: none; }.form-row { display: flex; gap: 12rpx; }.form-row picker { flex: 1; }.date-field { padding: 17rpx; border-radius: 15rpx; color: #56706a; font-size: 20rpx; text-align: center; background: #edf5f1; }.diary-title-input { height: 84rpx; margin-top: 16rpx; border-bottom: 1rpx solid #e8ece9; color: #3d514d; font-size: 27rpx; font-weight: 700; }.diary-content-input { width: 100%; height: 220rpx; padding: 20rpx 0; color: #61716d; font-size: 23rpx; line-height: 1.75; }.important-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-top: 1rpx solid #edf0ee; color: #4e625d; font-size: 22rpx; }.important-row text { display: block; margin-top: 5rpx; color: #9ba5a2; font-size: 18rpx; }.save-button { height: 84rpx; margin-top: 14rpx; border-radius: 42rpx; color: #fff; font-size: 24rpx; line-height: 84rpx; background: linear-gradient(90deg, #4ecdc4, #44a08d); }
.diary-item { position: relative; margin-bottom: 17rpx; padding: 26rpx; box-shadow: none; }.diary-date { display: flex; justify-content: space-between; color: #97a29e; font-size: 19rpx; }.diary-title { margin-top: 13rpx; color: #3d5952; font-size: 27rpx; font-weight: 700; }.diary-content { margin-top: 12rpx; color: #6e7d79; font-size: 22rpx; line-height: 1.7; white-space: pre-wrap; }.delete-diary { margin-top: 17rpx; color: #bf8b76; font-size: 19rpx; text-align: right; }
.masonry { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.moment { min-height: 190rpx; padding: 23rpx; border-radius: 24rpx; color: #536562; background: #e8f3ed; }.moment.tall { grid-row: span 2; min-height: 396rpx; color: #46606e; background: #e5f0f6; }.orange-card { background: #fff0e4; }.blue-card { background: #ebedfc; }.green-card { min-height: 130rpx; background: #e5f3e4; }.moment-icon { font-size: 38rpx; }.moment-title { margin-top: 18rpx; font-size: 25rpx; font-weight: 700; }.moment-text { margin-top: 12rpx; font-size: 21rpx; line-height: 1.65; }.last-line { margin: 60rpx 0 15rpx; color: #3e756b; font-size: 37rpx; line-height: 1.45; font-weight: 700; text-align: center; }
.song-actions { display: flex; gap: 10rpx; }.song-actions .change-song, .favorite-song { width: fit-content; height: 55rpx; margin: 14rpx 0 0; padding: 0 16rpx; border-radius: 28rpx; font-size: 18rpx; line-height: 55rpx; }.favorite-song { color: #8f8579; background: #f7f1e9; }.favorite-song.saved { color: #d27669; background: #fff0ed; }
.daily-page { background: #f5f8f6; }.daily-lead { margin-top: 24rpx; font-size: 25rpx; }.song-card { border-radius: 24rpx; background: #fff; }.diary-form, .diary-item { border-radius: 24rpx; }.save-button { background: linear-gradient(90deg, #55b69f, #3b958b); }.masonry { gap: 14rpx; }.moment { border-radius: 20rpx; }.diary-locked { color: #596f87; font-size: 26rpx; font-weight: 700; }.diary-locked text { display: block; margin-top: 16rpx; color: #8d9ca9; font-size: 21rpx; font-weight: 400; line-height: 1.7; }
.guest-module { padding-top: 96rpx; }.guest-module .guest-icon { margin-top: 70rpx; font-size: 100rpx; text-align: center; }.guest-module button { height: 84rpx; margin-top: 64rpx; border-radius: 42rpx; color: #fff; font-size: 24rpx; line-height: 84rpx; background: #438d81; }

/* 生活页：唱片与手账 */
.daily-page { background: radial-gradient(circle at 90% 6%, rgba(159,59,49,.08), transparent 20%), #f3efe5; }
.daily-lead { margin-top: 32rpx; padding: 24rpx 0 24rpx 25rpx; border-left: 3rpx solid #b18a55; color: #686c65; font-size: 27rpx; }
.song-card { min-height: 290rpx; padding: 34rpx; border-radius: 16rpx; background: linear-gradient(135deg, #243f3b, #395b52); box-shadow: 0 16rpx 38rpx rgba(35,53,47,.15); }
.record { width: 200rpx; height: 200rpx; border-color: #111d1c; box-shadow: 0 0 0 8rpx rgba(255,255,255,.06); }.record-center { color: #6f312c; background: #c69755; }
.song-label { color: #d2b47f; }.song-title { color: #fff7e7; }.song-artist, .song-note { color: #c8cdc5; }
.change-song, .favorite-song { border: 1rpx solid rgba(226,207,172,.25); color: #ebd4ad; background: rgba(255,255,255,.08); }.favorite-song.saved { color: #ffe2cd; background: #873a33; }
.diary-form, .diary-item { padding: 32rpx; border-radius: 16rpx; background: #fffdf7; }
.date-field { border: 1rpx solid #e2d7c3; border-radius: 7rpx; color: #655e53; background: #f5efe3; }.diary-title-input { border-color: #e5dbc8; }.important-row { border-color: #e8decd; }.save-button { border-radius: 8rpx; background: #963c33; }
.diary-item { border-left: 7rpx solid #355f55; }.diary-date { color: #9a7659; }.diary-title { color: #2c453e; }.delete-diary { color: #9d443a; }
.masonry { gap: 18rpx; }.moment { border: 1rpx solid rgba(65,63,53,.08); border-radius: 14rpx; background: #e8e0cf; }.moment.tall { color: #344e48; background: #dce6df; }.orange-card { background: #efe0ce; }.blue-card { background: #dde5e2; }.green-card { background: #e1e6d4; }
.last-line { color: #8d382f; font-family: "STKaiti", "KaiTi", serif; letter-spacing: 4rpx; }.guest-module button { border-radius: 8rpx; background: #234b43; }
