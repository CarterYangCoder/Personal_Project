.home { height: calc(100vh - 112rpx); }.top-note { display: flex; justify-content: space-between; color: #6f9188; font-size: 18rpx; font-weight: 600; letter-spacing: 2rpx; }.profile { display: flex; align-items: center; margin-top: 20rpx; padding: 20rpx 22rpx; box-shadow: none; }.avatar { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; border-radius: 22rpx; color: #fff; font-size: 30rpx; font-weight: 700; background: linear-gradient(135deg, #56c8bb, #2c9aa6); }.profile-copy { margin-left: 16rpx; }.profile-name { font-size: 27rpx; font-weight: 700; }.badge { display: inline-flex; margin-left: 8rpx; padding: 2rpx 8rpx; border-radius: 8rpx; color: #50a797; font-size: 17rpx; background: #e4f5ef; vertical-align: middle; }.profile-school { margin-top: 5rpx; color: #85908e; font-size: 19rpx; }.profile-action { margin-left: auto; padding: 10rpx 16rpx; border: 1rpx solid #d8ece5; border-radius: 999rpx; color: #6d8982; font-size: 19rpx; }.login-action { color: #258e7c; background: #e7f7f1; }.quick-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }.home-footer { margin: 48rpx 0 10rpx; color: #91a39e; font-size: 21rpx; line-height: 1.7; text-align: center; }.activity-head { margin-top: 50rpx; }

/* 首页：当代中式服务台 */
.home { background: linear-gradient(180deg, #eee8da 0, #f6f2e9 520rpx, #f3efe5 100%); }
.top-note { color: #886b55; letter-spacing: 3rpx; }
.top-note text { padding: 4rpx 10rpx; border: 1rpx solid #b24a3e; color: #a13d34; }
.app-hero { height: 450rpx; margin-top: 30rpx; border-radius: 18rpx; box-shadow: 0 22rpx 48rpx rgba(35,47,40,.2); }
.app-hero::before { position: absolute; z-index: 2; top: 20rpx; right: 20rpx; bottom: 20rpx; left: 20rpx; border: 1rpx solid rgba(239,221,188,.38); content: ''; pointer-events: none; }
.app-hero-shade { background: linear-gradient(90deg, rgba(18,43,38,.92), rgba(26,54,48,.35) 78%); }
.app-hero-copy { z-index: 3; padding: 43rpx; }
.app-hero-tag { color: #d7c39d; letter-spacing: 4rpx; }
.app-hero-title { font-size: 46rpx; line-height: 1.35; letter-spacing: 3rpx; }
.app-hero-footer text:last-child { border-radius: 6rpx; color: #e1b66f; }
.login-banner { margin-top: 26rpx; padding: 28rpx 30rpx; border: 1rpx solid #dfd2bd; border-radius: 14rpx; background: #fbf4e6; }
.login-banner-title { color: #7f382f; }.login-banner-note { color: #887b6c; }.login-banner-arrow { color: #a53b32; }
.service-dashboard { margin-top: 28rpx; padding: 30rpx; border-radius: 16rpx; background: linear-gradient(135deg, #193934, #31574d); box-shadow: 0 16rpx 35rpx rgba(25,52,47,.16); }
.dashboard-title text:last-child { color: #cfba92; }
.dashboard-grid { margin-top: 30rpx; }.dashboard-grid > view { color: #b5c1b8; }.dashboard-grid text { color: #f4ead7; }
.assistant-entry { min-height: 178rpx; padding: 30rpx; border-color: #dcd0bc; border-radius: 16rpx; background: linear-gradient(120deg, #fffaf0, #f0eadc); box-shadow: 0 13rpx 30rpx rgba(60,48,32,.07); }
.assistant-entry::after { border-color: rgba(164,59,49,.08); }
.assistant-orb { border-radius: 8rpx; background: #a53b32; box-shadow: 8rpx 8rpx 0 #ead8bc; }
.assistant-entry-label { color: #9d4036; }.assistant-entry-title { color: #293f39; font-size: 29rpx; }.assistant-entry-note { color: #7f7c72; }.assistant-entry-arrow { color: #a53b32; }
.quick-grid { gap: 18rpx; }
.bottom-tabs { height: calc(112rpx + env(safe-area-inset-bottom)); border-color: #dcd3c3; background: rgba(250,247,239,.97); box-shadow: 0 -10rpx 30rpx rgba(54,46,35,.05); }
.bottom-tab { color: #968e7f; }.bottom-tab.active { color: #953b32; }
.personal-top .page-title { color: #243d37; }
.personal-card { padding: 30rpx; border-radius: 16rpx; }
.avatar { border-radius: 50%; background: linear-gradient(135deg, #234b43, #a23d33); }
.profile-action { border-color: #d9c9af; border-radius: 6rpx; color: #8c463b; }
.personal-stats { border-radius: 16rpx; }.personal-stats > view { border-color: #eee5d5; }.personal-stats text { color: #7f382f; }
.private-note { border-left: 5rpx solid #a23d33; border-radius: 6rpx; color: #766e63; background: #eee6d7; }
.personal-locked button, .logout-button { border-radius: 8rpx; background: #234b43; }
.logout-button { color: #716b61; background: #e7dfd1; }
.login-banner { display: flex; justify-content: space-between; align-items: center; margin-top: 30rpx; padding: 25rpx 27rpx; border-radius: 24rpx; background: linear-gradient(120deg, #e8f8f3, #f6fcf9); }.login-banner-title { color: #367267; font-size: 25rpx; font-weight: 700; }.login-banner-note { margin-top: 9rpx; color: #79958e; font-size: 19rpx; }.login-banner-arrow { color: #45a792; font-size: 36rpx; }
.service-dashboard { margin-top: 28rpx; padding: 25rpx; border-radius: 28rpx; background: #263f3b; }.dashboard-title { display: flex; justify-content: space-between; color: #fff; font-size: 25rpx; font-weight: 700; }.dashboard-title text:last-child { color: #9dc5b9; font-size: 18rpx; font-weight: 400; }.dashboard-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 25rpx; }.dashboard-grid > view { padding-left: 16rpx; border-left: 1rpx solid rgba(255,255,255,.18); color: #a7c2b9; font-size: 17rpx; }.dashboard-grid > view:first-child { padding-left: 0; border: 0; }.dashboard-grid text { display: block; margin-bottom: 9rpx; color: #fff; font-size: 33rpx; font-weight: 700; }
.assistant-entry { position: relative; display: flex; align-items: center; min-height: 154rpx; margin-top: 28rpx; padding: 25rpx 24rpx; overflow: hidden; border: 1rpx solid rgba(75,146,132,.12); border-radius: 28rpx; background: linear-gradient(120deg, #e5f7f1 0%, #f8fcfa 62%, #e9f1ff 100%); box-shadow: 0 12rpx 30rpx rgba(37,75,70,.06); }.assistant-entry::after { position: absolute; top: -52rpx; right: -35rpx; width: 150rpx; height: 150rpx; border: 26rpx solid rgba(92,137,213,.08); border-radius: 50%; content: ''; }.assistant-orb { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border-radius: 26rpx; color: #fff; font-size: 34rpx; background: linear-gradient(145deg, #45ab95, #5b7fc4); box-shadow: 0 12rpx 25rpx rgba(58,128,116,.2); }.assistant-entry-copy { position: relative; z-index: 1; min-width: 0; margin-left: 20rpx; }.assistant-entry-label { color: #4a8d81; font-size: 16rpx; font-weight: 700; letter-spacing: 2rpx; }.assistant-entry-title { margin-top: 7rpx; color: #294b44; font-size: 27rpx; font-weight: 700; }.assistant-entry-note { margin-top: 7rpx; color: #748b85; font-size: 19rpx; line-height: 1.45; }.assistant-entry-arrow { position: relative; z-index: 1; margin-left: auto; padding-left: 12rpx; color: #4d8279; font-size: 32rpx; }
.app-hero { position: relative; height: 370rpx; margin-top: 28rpx; overflow: hidden; border-radius: 32rpx; box-shadow: 0 22rpx 45rpx rgba(40,89,79,.16); }.app-hero-image { width: 100%; height: 100%; }.app-hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(22,61,57,.84), rgba(22,61,57,.1) 75%); }.app-hero-copy { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 31rpx; color: #fff; }.app-hero-tag { color: rgba(235,255,248,.78); font-size: 16rpx; font-weight: 700; letter-spacing: 2.5rpx; }.app-hero-title { font-size: 40rpx; font-weight: 700; line-height: 1.3; letter-spacing: 1rpx; }.app-hero-footer { display: flex; justify-content: space-between; align-items: center; color: rgba(255,255,255,.85); font-size: 19rpx; }.app-hero-footer text:last-child { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border: 1rpx solid rgba(255,255,255,.55); border-radius: 50%; font-size: 24rpx; }
.profile-avatar-image { width: 100%; height: 100%; border-radius: 22rpx; }
.bottom-tabs { position: fixed; z-index: 5; right: 0; bottom: 0; left: 0; display: flex; height: calc(108rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid #e9f0ed; background: rgba(255,255,255,.96); }.bottom-tab { flex: 1; padding-top: 13rpx; color: #92a39e; font-size: 19rpx; line-height: 1.35; text-align: center; }.bottom-tab text { display: block; font-size: 31rpx; line-height: 1; }.bottom-tab.active { color: #318f7e; font-weight: 700; }.personal-top { margin-top: 10rpx; }.personal-top .page-title { margin-top: 48rpx; color: #2e4e46; }.personal-locked { margin-top: 48rpx; padding: 52rpx 36rpx; text-align: center; }.locked-icon { font-size: 70rpx; }.locked-title { margin-top: 18rpx; color: #31554c; font-size: 31rpx; font-weight: 700; }.locked-note { margin-top: 16rpx; color: #7c928c; font-size: 22rpx; line-height: 1.7; }.personal-locked button, .logout-button { height: 82rpx; margin-top: 34rpx; border-radius: 41rpx; color: #fff; font-size: 25rpx; line-height: 82rpx; background: #438d81; }.personal-card { display: flex; align-items: center; margin-top: 42rpx; padding: 26rpx; }.personal-stats { display: grid; grid-template-columns: repeat(2, 1fr); padding: 12rpx 0; }.personal-stats > view { padding: 25rpx 30rpx; border-bottom: 1rpx solid #edf3f0; color: #82938e; font-size: 20rpx; }.personal-stats > view:nth-last-child(-n+2) { border-bottom: 0; }.personal-stats text { display: block; margin-bottom: 9rpx; color: #2e5148; font-size: 40rpx; font-weight: 700; }.private-note { margin-top: 30rpx; padding: 24rpx; border-radius: 18rpx; color: #6d8982; font-size: 21rpx; line-height: 1.7; background: #e8f6f1; }.logout-button { color: #5d7a72; background: #edf3f0; }
