<view class="profile-page"><view class="page-shell"><view class="profile-top"><view class="back-chip" bindtap="back">← 返回</view><view>个人资料</view></view><view class="profile-title">编辑你的<br/>夏日身份。</view><view class="profile-card surface"><view class="profile-field-title">微信头像</view><button class="avatar-picker" style="width: 128rpx; height: 128rpx; min-height: 0; margin: 20rpx 0 0; padding: 0;" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"/><view wx:else>夏</view><text>更换</text></button><view class="profile-field-title nickname-label">昵称</view><input class="nickname-input" type="nickname" value="{{nickname}}" bindinput="inputNickname" maxlength="16" placeholder="点击获取微信昵称，或自行输入"/><button class="save-profile" bindtap="save">保存资料</button></view></view></view>
