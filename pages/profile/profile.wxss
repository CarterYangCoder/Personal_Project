.profile-page { min-height: 100vh; background: #f5f8f6; }.profile-top { display: flex; justify-content: space-between; align-items: center; color: #56746c; font-size: 22rpx; }.profile-title { margin-top: 55rpx; color: #2f4c44; font-size: 48rpx; font-weight: 700; line-height: 1.3; }.profile-card { margin-top: 48rpx; padding: 32rpx; }.profile-field-title { color: #58756d; font-size: 22rpx; font-weight: 700; }.avatar-picker { position: relative; display: flex; align-items: center; justify-content: center; overflow: visible; border-radius: 50%; color: #fff; font-size: 38rpx; font-weight: 700; line-height: 1; background: linear-gradient(135deg, #58c7b6, #318f9c); }.avatar-picker image { width: 128rpx; height: 128rpx; border-radius: 50%; }.avatar-picker text { position: absolute; right: -10rpx; bottom: 0; padding: 7rpx 12rpx; border: 2rpx solid #fff; border-radius: 999rpx; font-size: 17rpx; font-weight: 400; background: #438d81; }.nickname-label { margin-top: 45rpx; }.nickname-input { height: 88rpx; margin-top: 14rpx; padding: 0 20rpx; border: 1rpx solid #dceae5; border-radius: 18rpx; color: #36554d; font-size: 25rpx; background: #f9fcfa; }.save-profile { height: 88rpx; margin-top: 32rpx; border-radius: 44rpx; color: #fff; font-size: 25rpx; line-height: 88rpx; background: #438d81; }

.profile-page { background: radial-gradient(circle at 86% 12%, rgba(157,59,49,.1), transparent 25%), #f3efe5; }.profile-top { color: #796653; }.profile-title { margin-top: 70rpx; color: #243d37; font-size: 54rpx; letter-spacing: 5rpx; }
.profile-card { margin-top: 52rpx; padding: 40rpx; border-radius: 16rpx; background: #fffdf7; }.profile-card::before { display: block; width: 54rpx; height: 5rpx; margin-bottom: 34rpx; background: #963d34; content: ''; }
.profile-field-title { color: #704b3c; letter-spacing: 2rpx; }.avatar-picker { border: 6rpx solid #ece0cb; background: linear-gradient(135deg, #274c43, #963d34); }.avatar-picker text { border-radius: 5rpx; background: #963d34; }
.nickname-input { border-color: #ded2be; border-radius: 8rpx; background: #faf5eb; }.save-profile { border-radius: 8rpx; background: #963d34; box-shadow: 0 10rpx 20rpx rgba(126,49,43,.14); }
