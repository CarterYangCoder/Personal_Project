.work-page { height: 100vh; }.work-hero { position: relative; overflow: hidden; min-height: 510rpx; padding: 48rpx 36rpx; color: #fff; background: linear-gradient(145deg, #265e68, #409e91); }.hero-ring { position: absolute; top: -160rpx; right: -100rpx; width: 500rpx; height: 500rpx; border: 55rpx solid rgba(255,255,255,.12); border-radius: 50%; }.hero-kicker { position: relative; margin-top: 78rpx; color: rgba(255,255,255,.68); font-size: 20rpx; letter-spacing: 3rpx; }.hero-title { position: relative; margin-top: 22rpx; font-size: 57rpx; line-height: 1.25; font-weight: 700; }.hero-note { position: relative; margin-top: 20rpx; color: rgba(255,255,255,.8); font-size: 24rpx; }.paper-plane { position: absolute; right: 82rpx; bottom: 75rpx; color: #ffcc77; font-size: 78rpx; transform: rotate(-18deg); }.work-body { margin-top: -18rpx; padding-top: 46rpx; border-radius: 32rpx 32rpx 0 0; background: #fafaf7; }.handbook { position: relative; display: flex; width: 100%; height: 280rpx; margin-top: 30rpx; padding: 23rpx; overflow: hidden; background: #f5ebd7; }.book-spine { width: 54rpx; padding: 13rpx 8rpx; color: #f6e9ca; font-size: 13rpx; line-height: 1.4; letter-spacing: 1rpx; writing-mode: vertical-rl; background: #345b5a; }.book-cover { flex: 1; padding: 25rpx; color: #315b58; background: #fbf5e8; }.cover-tiny { font-size: 15rpx; letter-spacing: 2rpx; }.book-name { margin-top: 27rpx; font-size: 43rpx; line-height: 1.16; font-weight: 700; }.book-year { position: absolute; bottom: 29rpx; color: #88a39c; font-size: 20rpx; }.book-sticker { position: absolute; right: 30rpx; bottom: 29rpx; width: 112rpx; height: 112rpx; padding-top: 28rpx; border-radius: 50%; color: #b67342; font-size: 18rpx; line-height: 1.45; text-align: center; background: #ffd990; transform: rotate(11deg); }.stage { display: flex; padding: 22rpx 0; border-bottom: 1rpx dashed #dbe5e1; }.stage-num { width: 78rpx; color: #61b7a7; font-size: 23rpx; font-weight: 700; }.stage-copy { flex: 1; }.stage-top { display: flex; justify-content: space-between; color: #344b46; font-size: 27rpx; font-weight: 700; }.done { padding: 4rpx 11rpx; border-radius: 8rpx; color: #489f8d; font-size: 18rpx; font-weight: 400; background: #e7f6f0; }.stage-note { margin-top: 10rpx; color: #82908d; font-size: 22rpx; line-height: 1.65; }.stage-list { margin-bottom: 30rpx; }.team { padding: 27rpx; }.team-avatars { display: flex; flex-wrap: wrap; }.team-avatar { display: flex; align-items: center; justify-content: center; width: 57rpx; height: 57rpx; margin-right: 10rpx; margin-bottom: 12rpx; border: 3rpx solid #fff; border-radius: 50%; color: #4d8f84; font-size: 22rpx; background: #def1ec; }.team-avatar:nth-child(2n) { background: #fff0dd; color: #bc8562; }.team-word { margin-top: 10rpx; color: #75817f; font-size: 23rpx; line-height: 1.7; }.reflection { margin: 45rpx 12rpx 8rpx; color: #5b8b80; font-size: 26rpx; font-weight: 600; line-height: 1.7; text-align: center; }
.qr-section { display: flex; flex-direction: column; align-items: center; margin-top: 50rpx; padding: 30rpx 0 60rpx; }
.qr-label { margin-bottom: 20rpx; color: #5b8b80; font-size: 26rpx; font-weight: 600; }
.qr-img { width: 420rpx; border-radius: 20rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.08); background: #fff; }
.work-board { padding: 22rpx 26rpx; box-shadow: none; }.work-input-row { display: flex; flex-direction: row; align-items: center; }.work-input-row input { flex: 1; width: 0; min-width: 0; height: 74rpx; min-height: 74rpx; margin-right: 12rpx; padding: 0 16rpx; border-radius: 15rpx; color: #445b56; font-size: 21rpx; background: #f1f7f4; }.work-input-row button { width: 108rpx; min-width: 108rpx; height: 74rpx; min-height: 74rpx; margin: 0; padding: 0; border-radius: 15rpx; color: #fff; font-size: 21rpx; line-height: 74rpx; text-align: center; background: #438d81; }.board-empty { padding: 31rpx 8rpx 10rpx; color: #99a6a3; font-size: 20rpx; line-height: 1.7; text-align: center; }.board-task { display: flex; flex-direction: row; align-items: center; gap: 14rpx; padding: 20rpx 4rpx; border-bottom: 1rpx solid #edf1ef; }.task-check { display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; border: 2rpx solid #8fc7ba; border-radius: 50%; color: #fff; font-size: 18rpx; background: #fff; }.board-task-title { flex: 1; color: #4b605b; font-size: 22rpx; }.board-delete { color: #b8c2bf; font-size: 29rpx; }.board-task.is-done .task-check { background: #64ae9e; }.board-task.is-done .board-task-title { color: #a3afab; text-decoration: line-through; }
.work-hero { min-height: 430rpx; background: linear-gradient(145deg, #245d5d, #448f82); }.hero-kicker { margin-top: 58rpx; }.hero-title { font-size: 52rpx; }.work-body { background: #f5f8f6; }.handbook, .work-board, .team { border-radius: 24rpx; }.handbook { margin-top: 24rpx; }
.board-locked { color: #55736b; font-size: 25rpx; font-weight: 700; }.board-locked text { display: block; margin-top: 14rpx; color: #89a099; font-size: 20rpx; font-weight: 400; }
.guest-module { padding-top: 96rpx; }.guest-module .guest-icon { margin-top: 70rpx; font-size: 100rpx; text-align: center; }.guest-module button { height: 84rpx; margin-top: 64rpx; border-radius: 42rpx; color: #fff; font-size: 24rpx; line-height: 84rpx; background: #438d81; }

/* 工作页：青绿案卷 */
