.work-page { height: 100vh; background: #f3efe5; }
.work-hero { position: relative; min-height: 475rpx; padding: 56rpx 40rpx; overflow: hidden; color: #fff; background: linear-gradient(140deg, #173a35, #315b50 72%, #93673d); }
.work-hero::after { position: absolute; right: -70rpx; bottom: -190rpx; width: 650rpx; height: 420rpx; border-radius: 50% 50% 0 0; background: rgba(16,44,39,.46); content: ''; transform: rotate(-8deg); }
.hero-ring { position: absolute; top: -120rpx; right: -80rpx; width: 430rpx; height: 430rpx; border: 2rpx solid rgba(220,194,146,.22); border-radius: 50%; }
.hero-kicker { position: relative; z-index: 2; margin-top: 45rpx; color: #d2bd98; font-size: 19rpx; letter-spacing: 5rpx; }
.hero-title { position: relative; z-index: 2; margin-top: 20rpx; font-size: 60rpx; line-height: 1.22; font-weight: 700; letter-spacing: 6rpx; }
.hero-note { position: relative; z-index: 2; width: 79%; margin-top: 21rpx; color: rgba(245,236,219,.76); font-size: 23rpx; line-height: 1.65; }
.paper-plane { position: absolute; z-index: 2; right: 76rpx; bottom: 56rpx; color: #e0b36d; font-size: 72rpx; transform: rotate(9deg); }
.work-body { margin-top: -28rpx; padding-top: 0; border-radius: 28rpx 28rpx 0 0; background: #f3efe5; }

.work-summary { position: relative; z-index: 3; display: grid; grid-template-columns: repeat(3, 1fr); margin: 0 0 12rpx; overflow: hidden; border: 1rpx solid rgba(99,75,48,.11); border-radius: 20rpx; background: #fffdf7; box-shadow: 0 16rpx 34rpx rgba(55,43,28,.09); transform: translateY(-34rpx); }
.work-summary > view { padding: 21rpx 8rpx; border-left: 1rpx solid #ede4d4; text-align: center; }
.work-summary > view:first-child { border-left: 0; }
.work-summary text { display: block; color: #963d34; font-size: 34rpx; font-weight: 700; }
.work-summary view view { margin-top: 5rpx; color: #8e897e; font-size: 17rpx; }

.work-board { padding: 27rpx; border-radius: 19rpx; background: #fffdf7; box-shadow: 0 14rpx 34rpx rgba(60,47,31,.07); }
.form-heading { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 27rpx; }
.form-heading text { color: #283f39; font-size: 29rpx; font-weight: 700; }
.form-heading view view { margin-top: 7rpx; color: #999185; font-size: 18rpx; }
.cancel-edit { padding: 8rpx 13rpx; border-radius: 8rpx; color: #9c4138; font-size: 18rpx; background: #f8e8e2; }
.field-label { margin: 22rpx 2rpx 10rpx; color: #5b625c; font-size: 20rpx; font-weight: 700; }
.field-label text { margin-left: 7rpx; color: #ad4a40; font-size: 16rpx; font-weight: 400; }
.work-field { width: 100%; min-height: 73rpx; padding: 0 17rpx; border: 1rpx solid #e2d7c4; border-radius: 12rpx; color: #354b44; font-size: 21rpx; background: #f9f4ea; }
.title-field { color: #2b413b; font-size: 23rpx; background: #fffaf0; }
.work-textarea { height: 168rpx; padding-top: 17rpx; line-height: 1.6; }
.result-textarea { height: 125rpx; padding-top: 17rpx; line-height: 1.6; }
.date-time-row { display: grid; grid-template-columns: 1.15fr 1fr; gap: 12rpx; }
.date-picker { min-width: 0; }
.compact-field { display: flex; align-items: center; justify-content: space-between; height: 73rpx; min-height: 73rpx; }
.compact-field text { margin-right: 9rpx; color: #9a7761; font-size: 17rpx; }
.time-pair { display: flex; align-items: center; gap: 7rpx; min-width: 0; }
.time-pair picker { flex: 1; min-width: 0; }
.time-pair .compact-field { justify-content: center; padding: 0 8rpx; }
.time-pair > text { color: #aa9e8c; }
.form-bottom { display: flex; align-items: center; gap: 13rpx; margin-top: 27rpx; }
.status-picker { flex: 1; }
.status-select { display: flex; align-items: center; height: 72rpx; padding: 0 16rpx; border: 1rpx solid #ded1bd; border-radius: 11rpx; color: #51645e; font-size: 20rpx; background: #f5eee1; }
.save-work { width: 245rpx; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0; border-radius: 11rpx; color: #fff5e5; font-size: 21rpx; line-height: 72rpx; background: linear-gradient(135deg, #9f4037, #7f302b); box-shadow: 0 9rpx 20rpx rgba(139,48,43,.17); }

.journal-empty { padding: 45rpx 25rpx; border-radius: 18rpx; text-align: center; background: #fffdf7; }
.journal-empty > view:first-child { font-size: 52rpx; }.journal-empty text { display: block; margin-top: 12rpx; color: #3d514b; font-size: 24rpx; font-weight: 700; }.journal-empty > view:last-child { margin-top: 9rpx; color: #989288; font-size: 19rpx; }
.day-group { margin-bottom: 31rpx; }
.day-heading { display: flex; justify-content: space-between; align-items: center; margin: 0 4rpx 14rpx; color: #2c4840; font-size: 25rpx; font-weight: 700; }
.day-heading text { padding: 5rpx 12rpx; border-radius: 999rpx; color: #98735d; font-size: 16rpx; font-weight: 400; background: #eee2d2; }
.work-record { display: flex; align-items: stretch; }
.time-column { display: flex; flex: 0 0 82rpx; flex-direction: column; align-items: center; padding-top: 22rpx; color: #8c7d6b; font-size: 17rpx; }
.time-column view { flex: 1; width: 2rpx; min-height: 25rpx; margin-top: 10rpx; background: #d9cbb8; }
.work-record:last-child .time-column view { background: linear-gradient(#d9cbb8, transparent); }
.record-card { flex: 1; min-width: 0; margin-bottom: 15rpx; padding: 22rpx 23rpx; border-radius: 18rpx; background: #fffdf7; box-shadow: 0 10rpx 26rpx rgba(59,46,30,.055); }
.record-card.doing { border-left: 7rpx solid #b05a42; }.record-card.done { border-left: 7rpx solid #568070; }.record-card.pending { border-left: 7rpx solid #c8a66d; }
.record-top { display: flex; justify-content: space-between; align-items: center; }
.category-tag { max-width: 55%; overflow: hidden; color: #956147; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.status-tag { padding: 6rpx 12rpx; border-radius: 999rpx; color: #a1483d; font-size: 16rpx; background: #f8e7df; }
.done .status-tag { color: #467162; background: #e4eee8; }.pending .status-tag { color: #8a6c3f; background: #f5ecd9; }
.record-title { margin-top: 13rpx; color: #2e453e; font-size: 27rpx; font-weight: 700; line-height: 1.45; }
.done .record-title { color: #77827e; }
.record-details { margin-top: 11rpx; color: #69736d; font-size: 20rpx; line-height: 1.68; white-space: pre-wrap; }
.record-result { margin-top: 15rpx; padding: 14rpx 16rpx; border-radius: 10rpx; background: #f5eee2; }
.record-result text { color: #9b463d; font-size: 16rpx; font-weight: 700; }.record-result view { margin-top: 6rpx; color: #6f6e66; font-size: 19rpx; line-height: 1.55; }
.record-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 17rpx; padding-top: 14rpx; border-top: 1rpx dashed #e2d7c6; color: #9b958a; font-size: 16rpx; }
.record-footer view { display: flex; gap: 22rpx; }.record-footer view text:first-child { color: #58756b; }.record-footer view text:last-child { color: #a4665d; }

.project-review-head { margin-top: 66rpx; }
.project-title { margin-top: 12rpx; font-size: 42rpx; }
.handbook { position: relative; display: flex; width: 100%; height: 320rpx; margin-top: 26rpx; padding: 27rpx; overflow: hidden; border-radius: 16rpx; background: #ded0b7; box-shadow: 0 16rpx 35rpx rgba(60,49,33,.1); }
.book-spine { width: 62rpx; padding: 13rpx 8rpx; color: #dbc49c; font-size: 13rpx; line-height: 1.4; letter-spacing: 1rpx; writing-mode: vertical-rl; background: #203f39; }
.book-cover { flex: 1; padding: 29rpx; color: #29473f; background: #fbf5e8; }
.cover-tiny { font-size: 15rpx; letter-spacing: 2rpx; }.book-name { margin-top: 27rpx; font-size: 48rpx; line-height: 1.16; font-weight: 700; letter-spacing: 5rpx; }.book-year { position: absolute; bottom: 29rpx; color: #88a39c; font-size: 20rpx; }
.book-sticker { position: absolute; right: 30rpx; bottom: 29rpx; width: 112rpx; height: 112rpx; padding-top: 27rpx; border: 2rpx solid #a33c32; border-radius: 5rpx; color: #fff1dd; font-size: 18rpx; line-height: 1.45; text-align: center; background: #a33c32; transform: rotate(5deg); }
.stage-list { margin-bottom: 30rpx; }.stage { display: flex; padding: 28rpx 6rpx; border-bottom: 1rpx dashed #d9cdb9; }.stage-num { width: 78rpx; color: #9b3d34; font-size: 23rpx; font-weight: 700; }.stage-copy { flex: 1; }.stage-top { display: flex; justify-content: space-between; color: #344b46; font-size: 27rpx; font-weight: 700; }.stage .done { padding: 4rpx 11rpx; border-radius: 4rpx; color: #37695e; font-size: 18rpx; font-weight: 400; background: #e2ece6; }.stage-note { margin-top: 10rpx; color: #82908d; font-size: 22rpx; line-height: 1.65; }
.team { padding: 28rpx; border-radius: 16rpx; background: #fffdf7; }.team-avatars { display: flex; flex-wrap: wrap; }.team-avatar { display: flex; align-items: center; justify-content: center; width: 57rpx; height: 57rpx; margin: 0 10rpx 12rpx 0; border: 3rpx solid #fffaf0; border-radius: 50%; color: #8e3c33; font-size: 22rpx; background: #eee2cc; }.team-avatar:nth-child(2n) { color: #37695e; background: #e2ece6; }.team-word { margin-top: 10rpx; color: #75817f; font-size: 23rpx; line-height: 1.7; }
.reflection { margin: 55rpx 12rpx 8rpx; color: #7e3a32; font-size: 29rpx; line-height: 1.7; text-align: center; }
.qr-section { display: flex; flex-direction: column; align-items: center; margin-top: 50rpx; padding: 30rpx 0 80rpx; }.qr-label { margin-bottom: 20rpx; color: #5b786f; font-size: 25rpx; font-weight: 600; }.qr-img { width: 420rpx; padding: 16rpx; border: 1rpx solid #ded2bd; border-radius: 10rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.08); background: #fff; }

.guest-module { padding-top: 96rpx; background: radial-gradient(circle at 90% 12%, rgba(165,59,50,.08), transparent 25%), #f3efe5; }.guest-module .guest-icon { margin-top: 70rpx; font-size: 100rpx; text-align: center; }.guest-module button { height: 84rpx; margin-top: 64rpx; border-radius: 10rpx; color: #fff; font-size: 24rpx; line-height: 84rpx; background: #234b43; }
