<navigation-bar title="暑假一起过" background="#f5f1e8" color="#263534"></navigation-bar>
<scroll-view class="work-page" scroll-y scroll-with-animation scroll-into-view="{{scrollTarget}}">
  <view wx:if="{{!isLoggedIn}}" class="guest-module page-shell">
    <view class="eyebrow">DAILY WORK LOG</view><view class="page-title">每天做了什么，<br/>都值得记下来。</view>
    <view class="page-subtitle">登录后按日期和时间记录工作任务、过程与成果，慢慢积累自己的行动档案。</view><view class="guest-icon">📖</view>
    <button bindtap="goLogin">登录后开始记录</button>
  </view>

  <block wx:else>
    <view class="work-hero">
      <view class="hero-ring"></view><view class="hero-kicker">DAILY WORK LOG / 2026</view><view class="hero-title">我的每日<br/>工作记录</view>
      <view class="hero-note">不只记录“要做什么”，也留下什么时候做、怎么做，以及最后得到了什么。</view><view class="paper-plane">✦</view>
    </view>

    <view class="page-shell work-body">
      <view class="work-summary">
        <view><text>{{todayCount}}</text><view>今天记录</view></view><view><text>{{openTasks}}</text><view>还在推进</view></view><view><text>{{completedCount}}</text><view>已经完成</view></view>
      </view>

      <view class="section-head"><view class="section-title">记一笔今天的工作</view><view class="section-link">{{editingId ? '正在编辑' : '随时补记'}}</view></view>
      <view id="work-form" class="work-board surface">
        <form bindsubmit="saveTask">
          <view class="form-heading"><view><text>{{editingId ? '修改这条记录' : '今天做了什么？'}}</text><view>信息可以多写，也可以只记最重要的部分</view></view><view wx:if="{{editingId}}" class="cancel-edit" bindtap="cancelEdit">取消编辑</view></view>

          <view class="field-label">任务标题 <text>必填</text></view>
          <input class="work-field title-field" value="{{workTitle}}" bindinput="inputWorkTitle" maxlength="50" placeholder="例如：整理新生手册最终校对意见" />

          <view class="field-label">日期与时间</view>
          <view class="date-time-row">
            <picker class="date-picker" mode="date" value="{{workDate}}" bindchange="changeWorkDate"><view class="work-field compact-field"><text>日期</text>{{workDate}}⌄</view></picker>
            <view class="time-pair"><picker mode="time" value="{{startTime}}" bindchange="changeStartTime"><view class="work-field compact-field">{{startTime}}</view></picker><text>—</text><picker mode="time" value="{{endTime}}" bindchange="changeEndTime"><view class="work-field compact-field">{{endTime}}</view></picker></view>
          </view>

          <view class="field-label">任务类型</view>
          <input class="work-field" value="{{category}}" bindinput="inputCategory" maxlength="20" placeholder="例如：学生工作、课程项目、志愿服务" />

          <view class="field-label">过程记录</view>
          <textarea class="work-field work-textarea" value="{{details}}" bindinput="inputDetails" maxlength="500" placeholder="做了哪些事情？遇到了什么问题？和谁协作？"></textarea>

          <view class="field-label">成果与下一步</view>
          <textarea class="work-field result-textarea" value="{{result}}" bindinput="inputResult" maxlength="300" placeholder="完成了什么，或者下一步准备继续做什么？"></textarea>

          <view class="form-bottom"><picker class="status-picker" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="changeStatus"><view class="status-select">状态 · {{statusOptions[statusIndex]}}⌄</view></picker><button class="save-work" form-type="submit">{{editingId ? '保存修改' : '保存这条记录'}}</button></view>
        </form>
      </view>

      <view class="section-head"><view class="section-title">我的工作日历</view><view class="section-link">{{tasks.length}} 条记录</view></view>
      <view wx:if="{{!taskGroups.length}}" class="journal-empty surface"><view>☕</view><text>今天还没有工作记录</text><view>哪怕只完成一件小事，也可以写在这里。</view></view>
      <view class="day-group" wx:for="{{taskGroups}}" wx:key="date" wx:for-item="group">
        <view class="day-heading"><view>{{group.label}}</view><text>{{group.items.length}} 件事</text></view>
        <view class="day-timeline">
          <view class="work-record" wx:for="{{group.items}}" wx:key="id" wx:for-item="task">
            <view class="time-column"><text>{{task.startTime || '—'}}</text><view></view></view>
            <view class="record-card surface {{task.statusKey}}">
              <view class="record-top"><view class="category-tag">{{task.category}}</view><view class="status-tag" bindtap="cycleStatus" data-id="{{task.id}}" aria-role="button" aria-label="切换{{task.title}}的状态">{{task.status}} ↻</view></view>
              <view class="record-title">{{task.title}}</view>
              <view wx:if="{{task.details}}" class="record-details">{{task.details}}</view>
              <view wx:if="{{task.result}}" class="record-result"><text>成果 / 下一步</text><view>{{task.result}}</view></view>
              <view class="record-footer"><text>{{task.timeLabel}}</text><view><text bindtap="editTask" data-id="{{task.id}}" aria-role="button">编辑</text><text bindtap="deleteTask" data-id="{{task.id}}" aria-role="button">删除</text></view></view>
            </view>
          </view>
        </view>
      </view>

      <view class="section-head project-review-head"><view class="section-title">暑假项目回顾</view><view class="section-link">新生手册</view></view>
      <view class="eyebrow">THE FRESHMAN HANDBOOK</view><view class="page-title project-title">《新生手册》制作全记录</view>
      <view class="page-subtitle">面向 2026 级新同学的校园生存指南：从报到清单、部门地图，到那些不写在通知里的小事。</view>
      <view class="handbook surface"><view class="book-spine">OCEAN<br/>UNIVERSITY</view><view class="book-cover"><view class="cover-tiny">HELLO, FRESHMAN</view><view class="book-name">新生<br/>手册</view><view class="book-year">2026</view></view><view class="book-sticker">给新同学的<br/>第一封信</view></view>

      <view class="section-head"><view class="section-title">制作流程</view><view class="section-link">全部完成 ✓</view></view>
      <view class="stage-list"><view class="stage" wx:for="{{stages}}" wx:key="name"><view class="stage-num">0{{index + 1}}</view><view class="stage-copy"><view class="stage-top"><text>{{item.name}}</text><text class="done">已完成</text></view><view class="stage-note">{{item.note}}</view></view></view></view>
      <progress-bar label="手册完成度" value="100"></progress-bar>

      <view class="section-head"><view class="section-title">一起完成的人</view><view class="section-link">感谢各位部长</view></view>
      <view class="team surface"><view class="team-avatars"><view wx:for="{{team}}" wx:key="*this" class="team-avatar">{{item}}</view></view><view class="team-word">每一页的背后，都是一群人在假期里互相补位、认真较劲的身影。</view></view>
      <view class="reflection">“领导不是站在前面，而是在大家需要的时候，把事情稳稳接住。”</view>
      <view class="qr-section"><view class="qr-label">扫码加入学生会纳新群</view><image class="qr-img" src="/images/naxin1.png" mode="widthFix" show-menu-by-longpress></image></view>
    </view>
  </block>
</scroll-view>
