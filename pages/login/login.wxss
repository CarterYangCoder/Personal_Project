t(90deg, #50bfab, #368f9e); box-shadow: 0 12rpx 24rpx rgba(52,147,137,.2); }.login-tip { margin-top: 20rpx; color: #a3b1ad; font-size: 18rpx; }.glow { position: absolute; border-radius: 50%; filter: blur(6rpx); }.glow-one { top: -190rpx; right: -150rpx; width: 470rpx; height: 470rpx; background: rgba(122,218,191,.25); }.glow-two { bottom: -170rpx; left: -150rpx; width: 420rpx; height: 420rpx; background: rgba(255,205,131,.25); }

