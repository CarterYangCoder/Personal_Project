.volunteer-page { height: 100vh; background: #fffaf5; }
.vol-top { display: flex; justify-content: space-between; align-items: flex-start; }
.vol-label { color: #d28461; font-size: 17rpx; line-height: 1.35; letter-spacing: 2rpx; text-align: right; }
.vol-label text { font-size: 25rpx; font-weight: 700; }
.hero-copy { margin-top: 54rpx; }
.hero-icon { font-size: 70rpx; }
.hero-copy .page-title { margin-top: 18rpx; color: #39534d; font-size: 50rpx; }
.hero-desc { margin-top: 20rpx; color: #6d7c77; font-size: 25rpx; line-height: 1.8; }
.promise { margin-top: 36rpx; padding: 30rpx; box-shadow: none; }
.promise-title { margin-bottom: 8rpx; color: #3f5b54; font-size: 27rpx; font-weight: 700; }
.promise-row { display: flex; gap: 20rpx; padding: 21rpx 0; border-bottom: 1rpx solid #f0ece5; }
.promise-row:last-child { border: 0; }
.promise-row > text { color: #e78c62; font-size: 20rpx; font-weight: 700; }
.promise-row > view { flex: 1; }
.promise-name { color: #49615b; font-size: 24rpx; font-weight: 700; }
.promise-note { margin-top: 7rpx; color: #8a9692; font-size: 21rpx; line-height: 1.55; }
.project { margin-bottom: 20rpx; padding: 28rpx; border-radius: 26rpx; transition: all .25s ease; }
.project.yellow { background: #fff3d9; }.project.green { background: #e5f4e9; }.project.blue { background: #e3f1f7; }
.project.expanded { box-shadow: 0 14rpx 30rpx rgba(91, 94, 75, .1); }
.project-head { display: flex; justify-content: space-between; gap: 20rpx; }
.project-type { color: #b77c4b; font-size: 19rpx; letter-spacing: 1rpx; }
.project-title { margin-top: 8rpx; color: #354943; font-size: 29rpx; font-weight: 700; line-height: 1.4; }
.status-tag { flex: none; height: fit-content; padding: 7rpx 12rpx; border-radius: 12rpx; color: #667871; font-size: 19rpx; background: rgba(255,255,255,.65); }
.project-target { margin-top: 18rpx; color: #788681; font-size: 21rpx; }
.project-desc { margin-top: 14rpx; color: #5d6e69; font-size: 23rpx; line-height: 1.75; }
.need-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.need-row text { padding: 7rpx 13rpx; border-radius: 999rpx; color: #5f887d; font-size: 19rpx; background: rgba(255,255,255,.72); }
.expand-text { margin-top: 18rpx; color: #84948e; font-size: 20rpx; text-align: right; }
.join-form { padding: 30rpx; box-shadow: none; }
.field-label { margin: 22rpx 0 10rpx; color: #596d67; font-size: 22rpx; font-weight: 600; }.field-label:first-child { margin-top: 0; }
.field { width: 100%; min-height: 82rpx; padding: 20rpx 22rpx; border: 1rpx solid #e8e4dc; border-radius: 18rpx; color: #3e514c; font-size: 23rpx; background: #fffdf9; }
.picker-field { display: flex; justify-content: space-between; align-items: center; }
.textarea { height: 180rpx; line-height: 1.65; }
.join-button, .contact-button { height: 88rpx; border-radius: 44rpx; font-size: 25rpx; line-height: 88rpx; }
.join-button { margin-top: 28rpx; color: #fff; background: linear-gradient(90deg, #eea36f, #df7e5d); }
.prototype-tip { margin-top: 18rpx; color: #a0968d; font-size: 19rpx; line-height: 1.6; text-align: center; }
.intent { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 15rpx; padding: 24rpx; box-shadow: none; }
.intent-project { color: #405b54; font-size: 24rpx; font-weight: 700; }.intent-meta { margin-top: 6rpx; color: #9a9f9b; font-size: 19rpx; }.intent-message { margin-top: 12rpx; color: #6f7d78; font-size: 21rpx; line-height: 1.6; }.delete-link { flex: none; color: #c58c76; font-size: 20rpx; }
.intent-status { display: inline-block; margin-top: 14rpx; padding: 7rpx 12rpx; border-radius: 999rpx; color: #a47551; font-size: 17rpx; background: #fff3e7; }.intent-status.confirmed { color: #4d917e; background: #e5f4ec; }
.contact-button { margin-top: 42rpx; color: #d17858; border: 1rpx solid #edb094; background: transparent; }
.vol-ending { margin: 38rpx 20rpx 8rpx; color: #75857f; font-size: 24rpx; line-height: 1.8; text-align: center; }
.volunteer-page { background: #f5f8f6; }.hero-copy { margin-top: 42rpx; }.hero-icon { font-size: 58rpx; }.hero-copy .page-title { font-size: 45rpx; }.promise, .join-form, .intent { border-radius: 24rpx; }.project { border-radius: 24rpx; }.project.yellow, .project.green, .project.blue { border: 1rpx solid rgba(45,95,82,.06); background: #fff; }.project-type { color: #52947f; }.status-tag { color: #5d847a; background: #edf7f3; }.join-button { background: linear-gradient(90deg, #55b69f, #3b958b); }.contact-button { color: #438c7f; border-color: #9fd4c8; }
.login-lock { color: #56756d; font-size: 26rpx; font-weight: 700; }.login-lock text { display: block; margin-top: 16rpx; color: #8ba09a; font-size: 20rpx; font-weight: 400; line-height: 1.6; }
.guest-module { padding-top: 96rpx; }.guest-module .guest-icon { margin-top: 70rpx; font-size: 100rpx; text-align: center; }.guest-module button { height: 84rpx; margin-top: 64rpx; border-radius: 42rpx; color: #fff; font-size: 24rpx; line-height: 84rpx; background: #438d81; }

/* 公益页：朱砂善意簿 */
.volunteer-page { background: linear-gradient(180deg, #eee5d6 0, #f3efe5 500rpx); }
.vol-label { color: #8d765d; letter-spacing: 4rpx; }.vol-label text { color: #963d34; }
.hero-copy { position: relative; margin-top: 46rpx; padding: 40rpx 34rpx; overflow: hidden; border-radius: 16rpx; color: #f8efe0; background: linear-gradient(135deg, #8e372f, #a34c3c 62%, #6d2e2a); box-shadow: 0 17rpx 38rpx rgba(102,43,36,.18); }
.hero-copy::after { position: absolute; right: -75rpx; bottom: -80rpx; width: 270rpx; height: 270rpx; border: 32rpx solid rgba(245,221,180,.1); border-radius: 50%; content: ''; }
.hero-icon { font-size: 60rpx; }.hero-copy .page-title { color: #fff7e9; font-size: 46rpx; }.hero-desc { color: rgba(255,244,226,.78); }
.promise { padding: 34rpx; border-radius: 16rpx; background: #fffdf7; }.promise-title { color: #7e372f; font-size: 29rpx; }.promise-row { border-color: #e9ddc9; }.promise-row > text { color: #a43e34; }.promise-name { color: #2d4840; }
.project { margin-bottom: 20rpx; padding: 31rpx; border: 1rpx solid #e0d4bf !important; border-radius: 14rpx; background: #fffdf7 !important; box-shadow: 0 9rpx 24rpx rgba(62,51,35,.04); }
.project.yellow { border-left: 7rpx solid #ad8049 !important; }.project.green { border-left: 7rpx solid #4e7467 !important; }.project.blue { border-left: 7rpx solid #617582 !important; }
.project-type { color: #9b4036; letter-spacing: 2rpx; }.project-title { color: #263f38; font-size: 30rpx; }.status-tag { border-radius: 4rpx; color: #6b513f; background: #eee3d0; }.need-row text { border: 1rpx solid #dfd2bd; color: #6b5f50; background: #f7f0e4; }
.join-form, .intent { padding: 32rpx; border-radius: 16rpx; background: #fffdf7; }.field { border-color: #dfd3bf; border-radius: 8rpx; background: #faf5eb; }.join-button { border-radius: 8rpx; background: #963c33; }.contact-button { border-radius: 8rpx; color: #8b382f; border-color: #b8796d; }
.intent { border-left: 6rpx solid #355f55; }.intent-status { border-radius: 4rpx; color: #8d4a37; background: #f3e4d4; }.intent-status.confirmed { color: #315e52; background: #e0ebe3; }
.vol-ending { color: #7c463d; font-family: "STKaiti", "KaiTi", serif; font-size: 26rpx; }.guest-module button { border-radius: 8rpx; background: #963c33; }
