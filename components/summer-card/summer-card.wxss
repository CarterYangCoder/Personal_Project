.summer-card { position: relative; min-height: 178rpx; padding: 23rpx; overflow: hidden; border: 1rpx solid rgba(42,83,73,.07); border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 20rpx rgba(37,75,70,.035); }.mint { border-top: 6rpx solid #75bcae; }.orange { border-top: 6rpx solid #e6ae7c; }.blue { border-top: 6rpx solid #86abc3; }.purple { border-top: 6rpx solid #a89acb; }.card-icon { font-size: 38rpx; }.card-title { margin-top: 13rpx; color: #314440; font-size: 25rpx; font-weight: 700; }.card-note { margin-top: 6rpx; color: #82918e; font-size: 19rpx; }.card-arrow { position: absolute; right: 18rpx; bottom: 15rpx; color: #70a99d; font-size: 27rpx; }
.summer-card { min-height: 222rpx; padding: 28rpx; border-color: rgba(63,62,51,.1); border-radius: 16rpx; background: #fffdf7; box-shadow: 0 12rpx 28rpx rgba(59,49,35,.055); }
.summer-card::after { position: absolute; right: -48rpx; bottom: -58rpx; width: 150rpx; height: 150rpx; border: 1rpx solid rgba(158,57,47,.09); border-radius: 50%; content: ''; }
.mint, .orange, .blue, .purple { border-top: 0; }
.mint { border-left: 7rpx solid #376a5e; }.orange { border-left: 7rpx solid #a9693a; }.blue { border-left: 7rpx solid #536e7a; }.purple { border-left: 7rpx solid #7e6678; }
.card-icon { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border-radius: 50%; font-size: 32rpx; background: #f0eadc; }
.card-title { margin-top: 20rpx; color: #263d37; font-size: 27rpx; }
.card-note { margin-top: 9rpx; color: #817d72; font-size: 20rpx; }
.card-arrow { right: 22rpx; bottom: 19rpx; color: #a33d33; }
