.progress-wrap { width: 100%; }.progress-meta { display: flex; justify-content: space-between; color: #66827c; font-size: 22rpx; }.track { overflow: hidden; height: 12rpx; margin-top: 13rpx; border-radius: 99rpx; background: #e8f1ee; }.fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #4ecdc4, #44a08d); transition: width 1.1s cubic-bezier(.2,.75,.3,1); }
.progress-wrap { padding: 26rpx 28rpx; border: 1rpx solid #e0d4bf; border-radius: 12rpx; background: #fffdf7; }.progress-meta { color: #625b50; }.progress-meta text:last-child { color: #923b32; font-weight: 700; }.track { height: 10rpx; border-radius: 2rpx; background: #e8dfd0; }.fill { border-radius: 2rpx; background: linear-gradient(90deg, #294f46, #9b3d34); }
