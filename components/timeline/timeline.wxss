.timeline { margin-top: 4rpx; }
.timeline { padding: 12rpx 24rpx; border: 1rpx solid rgba(59,65,55,.08); border-radius: 16rpx; background: rgba(255,253,247,.72); }
.timeline-item { min-height: 150rpx; }
.timeline-date { width: 92rpx; color: #9b6a51; font-size: 21rpx; }
.dot { width: 44rpx; height: 44rpx; border: 1rpx solid #d9c8a9; border-radius: 8rpx; color: #8e352e; background: #f4ead9; }
.line { background: #d8cdb9; }
.timeline-title { color: #283f39; }
.timeline-desc { color: #7b7c73; }
.timeline-item { display: flex; min-height: 132rpx; }
.timeline-date { width: 88rpx; padding-top: 8rpx; color: #8d9795; font-size: 23rpx; font-weight: 600; }
.timeline-rail { position: relative; width: 58rpx; display: flex; justify-content: center; }
.dot { z-index: 1; display: flex; justify-content: center; align-items: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: #e3f5ef; color: #29947e; font-size: 20rpx; }
.line { position: absolute; top: 40rpx; bottom: -3rpx; width: 2rpx; background: #d9ebe5; }
.timeline-content { flex: 1; padding: 3rpx 0 28rpx 15rpx; }
.timeline-title { color: #304540; font-size: 29rpx; font-weight: 700; }
.timeline-desc { margin-top: 9rpx; color: #788481; font-size: 24rpx; line-height: 1.65; }
