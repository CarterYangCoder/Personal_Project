/* 现代东方视觉体系 */
page { min-height: 100%; background: #f3efe5; color: #243b36; font-family: "STKaiti", "KaiTi", "Songti SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; }
view, text, button, input, textarea { box-sizing: border-box; }
button { font-family: inherit; }
button::after { border: none; }
.page-shell { position: relative; min-height: 100vh; padding: 42rpx 34rpx calc(72rpx + env(safe-area-inset-bottom)); }
.page-shell::before { position: absolute; z-index: 0; top: 12rpx; right: 14rpx; width: 150rpx; height: 150rpx; border: 1rpx solid rgba(151,45,37,.08); border-radius: 50%; content: ''; pointer-events: none; }
.page-shell > view, .page-shell > block { position: relative; z-index: 1; }
.page-title { color: #203b35; font-size: 50rpx; line-height: 1.24; font-weight: 700; letter-spacing: 3rpx; }
.page-subtitle { margin-top: 16rpx; color: #78817a; font-size: 25rpx; line-height: 1.8; }
.eyebrow { display: inline-flex; align-items: center; color: #9a382f; font-size: 19rpx; font-weight: 700; letter-spacing: 4rpx; }
.eyebrow::before { width: 32rpx; height: 4rpx; margin-right: 12rpx; background: #b34337; content: ''; }
.surface { border: 1rpx solid rgba(55,67,58,.09); border-radius: 18rpx; background: rgba(255,253,247,.96); box-shadow: 0 14rpx 36rpx rgba(53,45,32,.07); }
.tap-scale { transition: transform .18s ease, box-shadow .18s ease; }
.tap-scale:active { transform: scale(.975); }
.muted { color: #8a8e86; }
.section-head { display: flex; justify-content: space-between; align-items: flex-end; margin: 52rpx 0 22rpx; padding-left: 18rpx; border-left: 6rpx solid #a53b32; }
.section-title { color: #253f38; font-size: 32rpx; font-weight: 700; letter-spacing: 2rpx; }
.section-link { color: #9b8068; font-size: 20rpx; }
.back-chip { display: inline-flex; align-items: center; padding: 13rpx 22rpx; border: 1rpx solid rgba(55,73,64,.12); border-radius: 8rpx; color: #355d53; font-size: 23rpx; background: rgba(255,253,247,.78); }
input, textarea { caret-color: #a53b32; }
